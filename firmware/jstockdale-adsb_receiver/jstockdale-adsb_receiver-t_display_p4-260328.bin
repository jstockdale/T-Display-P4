␀␀<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ADS-B Scope вЂ“ Off by One</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Space+Grotesk:wght@400;600;700&display=swap');
  :root { --bg:#0a0e14; --panel:#111820; --panel-border:#1e2a36; --text:#c8d6e5; --text-dim:#5c7080; --accent:#00e5a0; --accent-dim:rgba(0,229,160,0.15); --warning:#ff6b35; --blue:#4dabf7; }
  *{margin:0;padding:0;box-sizing:border-box}
  body{background:var(--bg);color:var(--text);font-family:'JetBrains Mono',monospace;height:100vh;overflow:hidden;-webkit-tap-highlight-color:transparent}
  #map{position:absolute;inset:0;z-index:1}
  .leaflet-tile-pane{filter:saturate(0.3) brightness(0.55) contrast(1.2)}
  .leaflet-control-attribution{display:none!important}
  #topbar{position:absolute;top:0;left:0;right:0;z-index:1000;background:linear-gradient(180deg,rgba(10,14,20,0.95),rgba(10,14,20,0.7));backdrop-filter:blur(10px);border-bottom:1px solid var(--panel-border);font-size:12px;display:flex;align-items:center;gap:14px;padding:10px 20px;flex-wrap:wrap}
  #topbar-spacer{flex:1 1 0;min-width:0}
  #topbar-right{display:flex;align-items:center;gap:8px;flex-shrink:0;margin-left:auto}
  #topbar .logo{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:15px;color:var(--accent);letter-spacing:-0.5px;white-space:nowrap}
  #topbar .logo span{color:var(--text-dim);font-weight:400}
  .scope-ver{font-size:10px;opacity:0.5}
  .stat{display:flex;align-items:center;gap:5px;color:var(--text-dim)}.stat .val{color:var(--text);font-weight:600;font-variant-numeric:tabular-nums}.stat .val.live{color:var(--accent)}
  #stats-bar{display:flex;align-items:center;gap:14px;flex-shrink:0}
  .topbtn{background:transparent;color:var(--text-dim);border:1px solid var(--panel-border);padding:4px 10px;border-radius:4px;font-family:inherit;font-size:11px;font-weight:600;cursor:pointer;text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;min-height:32px;touch-action:manipulation}
  .topbtn:hover{border-color:var(--text-dim);color:var(--text)}.topbtn.active{border-color:var(--accent);color:var(--accent)}
  #connect-btn{background:var(--accent);color:var(--bg);border:none;padding:6px 16px;border-radius:4px;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;min-height:36px;touch-action:manipulation}
  #connect-btn:hover{filter:brightness(1.15)}#connect-btn.connected{background:transparent;color:var(--accent);border:1px solid var(--accent)}
  #color-modes{display:flex;gap:3px;flex-shrink:0}
  #label-modes{display:flex;gap:3px;flex-shrink:0}
  #color-modes button,#label-modes button{background:transparent;color:var(--text-dim);border:1px solid var(--panel-border);padding:3px 7px;border-radius:3px;font-family:inherit;font-size:10px;cursor:pointer;font-weight:600;white-space:nowrap;min-height:28px;min-width:32px;touch-action:manipulation}
  #color-modes button:hover,#label-modes button:hover{border-color:var(--text-dim)}#color-modes button.active,#label-modes button.active{border-color:var(--accent);color:var(--accent)}
  #ac-map-btn,#mesh-map-btn{background:transparent;color:var(--text-dim);border:1px solid var(--panel-border);padding:3px 7px;border-radius:3px;font-family:inherit;font-size:10px;cursor:pointer;font-weight:600;white-space:nowrap;min-height:28px;touch-action:manipulation}
  #ac-map-btn:hover,#mesh-map-btn:hover{border-color:var(--text-dim)}#ac-map-btn.active{border-color:var(--accent);color:var(--accent)}#mesh-map-btn.active{border-color:var(--blue);color:var(--blue)}
  #panel{position:absolute;bottom:0;left:0;right:0;z-index:1000;background:linear-gradient(0deg,rgba(10,14,20,0.97),rgba(10,14,20,0.85));backdrop-filter:blur(10px);border-top:1px solid var(--panel-border);height:35vh;overflow:hidden;display:flex;flex-direction:column}
  #panel.collapsed{height:44px}
  #panel-drag{height:12px;cursor:ns-resize;flex-shrink:0;display:flex;align-items:center;justify-content:center;touch-action:none}
  #panel-drag::after{content:'';width:40px;height:3px;background:var(--panel-border);border-radius:2px}
  #panel-drag:hover::after{background:var(--text-dim)}
  #panel-toggle{width:100%;padding:4px 8px;background:none;border:none;color:var(--text-dim);font-family:inherit;font-size:11px;cursor:pointer;text-align:center;letter-spacing:1px;text-transform:uppercase;flex-shrink:0;min-height:32px;touch-action:manipulation}
  #panel-scroll{flex:1;overflow:auto;-webkit-overflow-scrolling:touch;outline:none}
  #ac-table{width:100%;border-collapse:collapse;font-size:11px;min-width:700px}
  #ac-table th{position:sticky;top:0;background:var(--panel);color:var(--text-dim);text-align:left;padding:6px 10px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;font-size:10px;border-bottom:1px solid var(--panel-border)}
  #ac-table td{padding:5px 10px;border-bottom:1px solid rgba(30,42,54,0.4);white-space:nowrap}
  #ac-table tr:hover td{background:var(--accent-dim);cursor:pointer}
  #ac-table tr.selected td{background:rgba(77,171,247,0.15);border-bottom-color:rgba(77,171,247,0.1)}
  #ac-table tr.kb-focus td{box-shadow:0 1px 0 var(--accent),0 -1px 0 var(--accent);border-bottom-color:transparent}
  #ac-table tr.kb-focus td:first-child{box-shadow:0 1px 0 var(--accent),0 -1px 0 var(--accent),-1px 0 0 var(--accent)}
  #ac-table tr.kb-focus td:last-child{box-shadow:0 1px 0 var(--accent),0 -1px 0 var(--accent),1px 0 0 var(--accent)}
  .col-icao{font-weight:600}.col-cs{color:var(--text);font-weight:600}.col-alt{color:var(--accent)}
  #ac-table th{cursor:pointer;user-select:none;white-space:nowrap}#ac-table th:hover{color:var(--accent)}
  #ac-table th span{font-size:9px;opacity:0.6;display:inline-block;width:10px;text-align:center}
  .col-vr.climbing{color:var(--accent)}.col-vr.descending{color:var(--warning)}.col-dist{color:var(--text-dim)}
  .leaflet-div-icon{background:none!important;border:none!important}
  .leaflet-control-zoom{display:none!important}
  #zoom-ctrl{position:absolute;right:12px;z-index:1000;display:flex;flex-direction:row;gap:8px}
  #zoom-ctrl button{width:36px;height:36px;background:var(--panel);color:var(--text);border:1px solid var(--panel-border);border-radius:4px;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-family:inherit;touch-action:manipulation}
  #zoom-ctrl button:hover{background:var(--panel-border);color:#fff}
  #legend{display:none;position:absolute;left:12px;z-index:999;background:rgba(17,24,32,0.9);border:1px solid var(--panel-border);border-radius:6px;padding:8px 10px;font-size:10px;color:var(--text-dim)}
  #legend.visible{display:block}
  #legend .ltitle{font-weight:600;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;color:var(--text)}
  #legend .lbar{width:120px;height:8px;border-radius:2px;margin:4px 0}
  #legend .lrange{display:flex;justify-content:space-between;font-size:9px}
  #gnss-info{position:absolute;top:66px;left:12px;z-index:999;background:rgba(17,24,32,0.9);border:1px solid var(--panel-border);border-radius:6px;padding:8px 12px;font-size:11px;color:var(--text-dim);line-height:1.6}
  #gnss-info .fix{color:var(--accent);font-weight:600}#gnss-info .nofix{color:var(--warning);font-weight:600}
  #gnss-info .utc-none{color:var(--text-dim)}#gnss-info .utc-live{color:var(--accent);font-weight:600}#gnss-info .utc-stale{color:#ff6b6b;font-weight:600}
  #session-panel{position:absolute;top:52px;right:12px;z-index:999;font-size:10px;font-family:'JetBrains Mono',monospace;line-height:1.5;display:none;grid-template-columns:auto auto;gap:0 6px;background:rgba(17,24,32,0.85);border:1px solid var(--panel-border);border-radius:4px;padding:4px 8px}
  #session-panel.visible{display:grid}
  #session-panel .sess-on{color:var(--accent)}#session-panel .sess-off{color:#ff6b6b}
  #sd-info{color:var(--text-dim);font-size:10px;margin-top:4px;padding-top:4px;border-top:1px solid var(--panel-border)}
  #sd-info #sd-logs{display:inline-block;vertical-align:top}
  #sd-info .sd-ok{color:var(--accent)}#sd-info .sd-meshy{color:var(--blue)}#sd-info .sd-err{color:var(--warning)}#sd-info .sd-wait{color:var(--text-dim)}
  #detail-wrap{position:absolute;top:66px;right:12px;bottom:calc(var(--panel-h, 35vh) + 8px);z-index:1000;overflow-y:auto;overflow-x:hidden;display:none;flex-direction:column;gap:8px;width:240px;padding-bottom:8px;-webkit-overflow-scrolling:touch}
  #detail-wrap.visible{display:flex}
  .det-card{background:rgba(17,24,32,0.95);border:1px solid var(--panel-border);border-radius:6px;padding:10px 14px;font-size:12px;color:var(--text);line-height:1.7;flex-shrink:0}
  .det-card .dh{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;border-bottom:1px solid var(--panel-border);padding-bottom:4px}
  .dh .dcs{font-weight:700;font-size:16px;color:var(--accent)}.dh .dicao{color:var(--blue);font-size:11px}
  .dh .dx{background:none;border:none;color:var(--text-dim);font-size:16px;cursor:pointer;padding:4px 8px;min-width:32px;min-height:32px;display:flex;align-items:center;justify-content:center;touch-action:manipulation}.dh .dx:hover{color:var(--text)}
  .dr{display:flex;justify-content:space-between;gap:16px}.dl{color:var(--text-dim);font-size:10px;text-transform:uppercase;letter-spacing:0.5px}
  .dv{font-weight:600}.dv.up{color:var(--accent)}.dv.dn{color:var(--warning)}
  #log-panel{display:none;position:absolute;top:160px;left:12px;z-index:1001;width:min(640px,calc(100vw - 24px));height:min(400px,calc(100vh - 220px));background:rgba(10,14,20,0.96);border:1px solid var(--panel-border);border-radius:6px;overflow:hidden;flex-direction:column;resize:both}
  #log-panel.visible{display:flex}
  #log-header{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border-bottom:1px solid var(--panel-border);font-size:11px;color:var(--text-dim);font-weight:600;text-transform:uppercase;letter-spacing:0.5px;flex-shrink:0}
  #log-header button{background:none;border:none;color:var(--text-dim);font-size:14px;cursor:pointer;padding:4px 8px;min-width:32px;min-height:32px;touch-action:manipulation}#log-header button:hover{color:var(--text)}
  #log-controls{display:flex;gap:10px;align-items:center;padding:6px 12px;border-bottom:1px solid var(--panel-border);flex-shrink:0}
  #log-controls label{font-size:10px;color:var(--text-dim);display:flex;align-items:center;gap:4px;cursor:pointer;min-height:32px;touch-action:manipulation}
  #log-controls input[type="checkbox"]{accent-color:var(--accent);width:16px;height:16px}
  #log-output{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:8px 12px;font-size:10px;line-height:1.5;color:var(--text);white-space:pre;font-family:'JetBrains Mono',monospace}
  .log-adsb{color:var(--accent)}.log-gnss{color:var(--blue)}.log-info{color:var(--text-dim)}.log-error{color:var(--warning)}.log-scope{color:#c792ea}.log-meshy{color:var(--blue)}.log-console{color:#e5c07b}
  #meshy-panel{display:none;position:absolute;top:160px;right:12px;z-index:1001;width:min(480px,calc(100vw - 24px));height:min(400px,calc(100vh - 220px));background:rgba(10,14,20,0.96);border:1px solid var(--panel-border);border-radius:6px;overflow:hidden;flex-direction:column;resize:both;min-width:240px;min-height:200px}
  #meshy-panel.visible{display:flex}
  #meshy-header{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border-bottom:1px solid var(--panel-border);font-size:11px;color:var(--text-dim);font-weight:600;text-transform:uppercase;letter-spacing:0.5px;flex-shrink:0;cursor:grab;user-select:none;touch-action:none}
  #meshy-header.dragging{cursor:grabbing}
  #meshy-header button{background:none;border:none;color:var(--text-dim);font-size:14px;cursor:pointer;padding:4px 8px;min-width:32px;min-height:32px;touch-action:manipulation}#meshy-header button:hover{color:var(--text)}
  #meshy-stats{padding:6px 12px;border-bottom:1px solid var(--panel-border);font-size:10px;color:var(--text-dim);flex-shrink:0}
  #meshy-controls{display:flex;gap:10px;align-items:center;padding:4px 12px;border-bottom:1px solid var(--panel-border);flex-shrink:0}
  #meshy-controls label{font-size:10px;color:var(--text-dim);display:flex;align-items:center;gap:4px;cursor:pointer;min-height:28px;touch-action:manipulation}
  #meshy-controls input[type="checkbox"]{accent-color:var(--accent);width:14px;height:14px}
  #meshy-output{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:4px 10px;font-size:10px;line-height:1.4;color:var(--text)}
  .meshy-msg{padding:1px 0;cursor:pointer}.meshy-msg:hover{background:rgba(0,229,160,0.05)}
  .meshy-msg.selected{background:rgba(77,171,247,0.12);border-left:2px solid var(--blue);padding-left:4px}
  .meshy-msg .mn{color:var(--blue);font-weight:600}.meshy-msg .mt{color:var(--text)}.meshy-msg .mp{color:var(--text-dim)}.meshy-msg .mj{color:var(--blue);font-style:italic}
  .meshy-msg .mts{color:var(--text-dim);font-size:9px;opacity:0.5;margin-right:3px;font-variant-numeric:tabular-nums}
  .meshy-msg .mr{color:var(--text-dim);font-size:9px;opacity:0.5}.meshy-msg .mx{color:var(--accent);font-size:9px;font-weight:600;cursor:pointer;padding:2px 4px;border-radius:3px}.meshy-msg .mx:hover{background:rgba(0,229,160,0.2)}
  .meshy-msg .ml{color:var(--blue);font-size:9px;opacity:0.6;margin-right:2px}
  .meshy-msg .md{display:none;padding:2px 0 2px 12px;font-size:9px;color:var(--text-dim);line-height:1.3;border-left:1px solid var(--panel-border);margin:1px 0 1px 4px}
  .meshy-msg.expanded .md{display:block}
  .meshy-msg.tx-out{opacity:0.8}.meshy-msg.tx-out .mn{color:var(--accent)}
  .meshy-msg .mk{color:#e5c07b;font-size:9px;font-weight:600;margin-right:2px}
  #meshy-tx-bar{display:flex;gap:6px;padding:6px 10px;border-top:1px solid var(--panel-border);flex-shrink:0}
  #meshy-tx-input{flex:1;background:rgba(20,30,40,0.9);border:1px solid var(--panel-border);border-radius:4px;padding:6px 8px;color:var(--text);font-family:inherit;font-size:11px;outline:none;min-height:28px}
  #meshy-tx-input:focus{border-color:var(--accent)}
  #meshy-tx-input::placeholder{color:var(--text-dim);opacity:0.5}
  #meshy-tx-btn{background:var(--accent);color:#0a0e14;border:none;border-radius:4px;padding:6px 14px;font-family:inherit;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;min-height:28px;touch-action:manipulation}
  #meshy-tx-btn:hover{filter:brightness(1.15)}
  #meshy-tx-btn:disabled{opacity:0.4;cursor:default}
  .ac-label{display:inline-block;background:rgba(10,14,20,0.8);border:1px solid rgba(255,255,255,0.08);border-radius:3px;padding:2px 5px;font-family:'JetBrains Mono',monospace;font-size:10px;white-space:nowrap;cursor:pointer;pointer-events:auto;text-shadow:0 0 3px rgba(0,0,0,0.9),0 0 6px rgba(0,0,0,0.7)}
  .ac-label.sel{outline:1.5px solid currentColor;outline-offset:1px;background:rgba(10,14,20,0.85);text-shadow:0 0 6px currentColor,0 0 2px rgba(0,0,0,0.9)}
  .mesh-label{display:inline-block;font-family:'JetBrains Mono',monospace;font-size:9px;color:#4dabf7;white-space:nowrap;text-shadow:0 0 3px rgba(0,0,0,0.9),0 0 6px rgba(0,0,0,0.7);pointer-events:none}
  .mesh-bubble{display:inline-block;font-family:'JetBrains Mono',monospace;font-size:9px;color:#4dabf7;background:rgba(10,14,20,0.85);border:1px solid rgba(77,171,247,0.5);border-radius:3px;padding:2px 6px;white-space:nowrap;max-width:220px;overflow:hidden;text-overflow:ellipsis;text-shadow:0 0 6px rgba(77,171,247,0.6),0 0 2px rgba(0,0,0,0.9);pointer-events:none}
  .ac-icon{font-size:18px}
  /* Timeline */
  #timeline{display:none;position:absolute;top:0;left:0;right:0;z-index:1000;background:rgba(10,14,20,0.95);border-bottom:1px solid var(--panel-border);padding:8px 16px;align-items:center;gap:12px;font-size:11px}
  #timeline.visible{display:flex}
  #timeline .tl-time{color:var(--accent);font-weight:600;min-width:170px;font-variant-numeric:tabular-nums}
  #timeline .tl-speed{color:var(--text-dim);min-width:40px;text-align:center}
  #tl-scrub{flex:1;height:6px;-webkit-appearance:none;appearance:none;background:var(--panel-border);border-radius:3px;cursor:pointer;outline:none}
  #tl-scrub::-webkit-slider-thumb{-webkit-appearance:none;width:24px;height:24px;border-radius:50%;background:var(--accent);cursor:grab;border:2px solid var(--bg)}
  #tl-scrub::-moz-range-thumb{width:24px;height:24px;border-radius:50%;background:var(--accent);cursor:grab;border:2px solid var(--bg)}
  #timeline button{background:none;border:1px solid var(--panel-border);color:var(--text);border-radius:4px;padding:6px 10px;font-family:inherit;font-size:12px;cursor:pointer;min-width:36px;min-height:36px;touch-action:manipulation}
  #timeline button:hover{border-color:var(--text-dim)}
  #timeline button.active{border-color:var(--accent);color:var(--accent)}
  #csv-btn{background:transparent;color:var(--text-dim);border:1px solid var(--panel-border);padding:4px 10px;border-radius:4px;font-family:inherit;font-size:11px;font-weight:700;cursor:pointer;text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;min-height:32px;touch-action:manipulation}
  #csv-btn:hover{border-color:var(--text-dim);color:var(--text)}
  /* File browser */
  #files-panel{display:none;position:absolute;top:160px;left:12px;z-index:1002;width:min(500px,calc(100vw - 24px));height:min(400px,calc(100vh - 220px));background:rgba(10,14,20,0.97);border:1px solid var(--panel-border);border-radius:6px;overflow:hidden;flex-direction:column;resize:both}
  @media(min-width:1100px){#files-panel.side-by-side{left:calc(12px + min(640px,calc(100vw - 24px)) + 12px);width:min(500px,calc(100vw - 688px))}}
  #files-panel.visible{display:flex}
  #files-header{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border-bottom:1px solid var(--panel-border);font-size:11px;color:var(--text-dim);font-weight:600;text-transform:uppercase;letter-spacing:0.5px;flex-shrink:0;cursor:grab;user-select:none;touch-action:none}
  #files-header.dragging{cursor:grabbing}
  #files-header button{background:none;border:none;color:var(--text-dim);font-size:14px;cursor:pointer;padding:4px 8px;min-width:32px;min-height:32px;touch-action:manipulation}#files-header button:hover{color:var(--text)}
  #files-path{padding:6px 12px;font-size:11px;color:var(--accent);border-bottom:1px solid var(--panel-border);flex-shrink:0}
  #files-status{padding:4px 12px;font-size:10px;color:var(--text-dim);border-bottom:1px solid var(--panel-border);flex-shrink:0;min-height:22px;position:relative;overflow:hidden}
  #files-status .dl-bar{position:absolute;left:0;top:0;bottom:0;background:rgba(0,255,170,0.12);transition:width 0.3s ease;pointer-events:none}
  #files-list{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:4px 0}
  .file-row{display:flex;align-items:center;padding:6px 12px;gap:10px;cursor:pointer;font-size:11px;touch-action:manipulation}
  .file-row:hover{background:var(--accent-dim)}
  .file-icon{width:18px;text-align:center;flex-shrink:0}
  .file-name{flex:1;color:var(--text);overflow:hidden;text-overflow:ellipsis}
  .file-name.dir{color:var(--blue);font-weight:600}
  .file-size{color:var(--text-dim);font-size:10px;min-width:60px;text-align:right}
  .file-actions{display:flex;gap:3px}
  .file-actions button{background:var(--panel);border:1px solid var(--panel-border);color:var(--text-dim);border-radius:3px;padding:2px 6px;font-size:9px;cursor:pointer;font-family:inherit;text-transform:uppercase;touch-action:manipulation}
  .file-actions button:hover{color:var(--accent);border-color:var(--accent)}
  .file-row.active-log{border-left:2px solid var(--accent)}
  .file-row.active-log .file-name{color:var(--accent);font-weight:600}
  ::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--panel-border);border-radius:3px}

  /* в•ђв•ђв•ђ Mobile в•ђв•ђв•ђ */
  @media(max-width:768px){
    #topbar{padding:8px 10px;gap:6px}
    #topbar .logo span{display:none}
    .stat.hm{display:none}
    #topbar-spacer{display:none}

    #gnss-info{font-size:10px;padding:6px 10px;max-width:calc(100vw - 70px)}
    #detail-wrap{right:8px;width:200px;max-height:50vh}
    #panel{height:30vh}

    #log-panel{top:auto!important;bottom:0!important;left:0!important;right:0!important;width:100%!important;height:50vh!important;border-radius:6px 6px 0 0;resize:none}
    #meshy-panel{top:auto!important;bottom:0!important;left:0!important;right:0!important;width:100%!important;height:50vh!important;border-radius:6px 6px 0 0;resize:none}
    #files-panel{top:auto!important;bottom:0!important;left:0!important;right:0!important;width:100%!important;height:50vh!important;border-radius:6px 6px 0 0;resize:none}
    #flash-panel{width:calc(100vw - 20px);max-height:90vh;overflow-y:auto}

    #timeline{flex-wrap:wrap;padding:6px 10px;gap:6px}
    #timeline .tl-time{min-width:auto;font-size:10px;order:10;width:100%;text-align:center}
    #tl-scrub{min-width:0}

    #zoom-ctrl{right:8px}

    #ac-table{font-size:10px}
    #ac-table th,#ac-table td{padding:5px 6px}
    .ac-label{font-size:9px}
  }

  /* в•ђв•ђв•ђ Small phones в•ђв•ђв•ђ */
  @media(max-width:420px){
    #topbar .logo{font-size:13px}
    #connect-btn{padding:6px 8px;font-size:10px;letter-spacing:0}
    #gnss-info{font-size:9px;padding:4px 8px}
  }
  /* Flash panel */
  #flash-panel{display:none;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:2000;width:min(520px,calc(100vw - 40px));background:rgba(10,14,20,0.98);border:1px solid var(--panel-border);border-radius:8px;overflow:hidden;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,0.6)}
  #flash-panel.visible{display:flex}
  #flash-header{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--panel-border);font-size:12px;color:var(--text);font-weight:700;text-transform:uppercase;letter-spacing:0.5px;flex-shrink:0}
  #flash-header button{background:none;border:none;color:var(--text-dim);font-size:14px;cursor:pointer;padding:4px 8px;min-width:32px;min-height:32px;touch-action:manipulation}#flash-header button:hover{color:var(--text)}
  #flash-body{padding:16px;font-size:12px;line-height:1.8;color:var(--text-dim)}
  .flash-row{display:flex;justify-content:space-between;align-items:center;padding:4px 0}.flash-row .fl{text-transform:uppercase;font-size:10px;letter-spacing:0.5px;color:var(--text-dim)}.flash-row .fv{color:var(--text);font-weight:600}
  .flash-row .fv.ok{color:var(--accent)}.flash-row .fv.warn{color:var(--warning)}
  #flash-progress{display:none;margin:12px 0}
  #flash-progress-bar{width:100%;height:6px;background:var(--panel-border);border-radius:3px;overflow:hidden}
  #flash-progress-fill{height:100%;width:0%;background:var(--accent);border-radius:3px;transition:width 0.3s ease}
  #flash-progress-text{font-size:10px;color:var(--text-dim);margin-top:4px;font-variant-numeric:tabular-nums}
  #flash-log{max-height:180px;overflow-y:auto;margin-top:12px;padding:10px;background:rgba(0,0,0,0.3);border-radius:4px;font-size:10px;line-height:1.6;white-space:pre-wrap;font-family:'JetBrains Mono',monospace;color:var(--text-dim)}
  #flash-log .fl-ok{color:var(--accent)}#flash-log .fl-err{color:var(--warning)}#flash-log .fl-info{color:var(--blue)}
  #flash-actions{display:flex;gap:8px;margin-top:14px}
  .flash-btn{flex:1;padding:10px;border-radius:5px;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;text-transform:uppercase;letter-spacing:0.5px;text-align:center;border:none;min-height:44px;touch-action:manipulation}
  .flash-btn.primary{background:var(--accent);color:var(--bg)}.flash-btn.primary:hover{filter:brightness(1.15)}
  .flash-btn.primary:disabled{opacity:0.4;cursor:not-allowed;filter:none}
  .flash-btn.secondary{background:transparent;color:var(--text-dim);border:1px solid var(--panel-border)}.flash-btn.secondary:hover{border-color:var(--text-dim);color:var(--text)}
  #flash-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1999}#flash-overlay.visible{display:block}
  #flash-badge{display:none;width:7px;height:7px;border-radius:50%;background:var(--warning);margin-left:4px;vertical-align:middle;animation:badge-pulse 2s infinite}
  @keyframes badge-pulse{0%,100%{opacity:1}50%{opacity:0.4}}
</style>
</head>
<body>
<div id="topbar">
  <div class="logo">ADS-B SCOPE <span>/ Off by One <span class="scope-ver">v1.0.6</span></span></div>
  <div id="stats-bar">
    <div class="stat"><span>AC</span><span class="val live" id="ac-count">0</span></div>
    <div class="stat hm"><span>MSG</span><span class="val" id="msg-count">0</span></div>
    <div class="stat hm"><span>MSG/s</span><span class="val" id="msg-rate">0</span></div>
  </div>
  <div id="color-modes">
    <button class="active" onclick="setCM('mono')" id="cm-mono" title="Terminal green">MONO</button>
    <button onclick="setCM('rainbow')" id="cm-rainbow" title="Rainbow by aircraft">рџЊ€</button>
    <button onclick="setCM('alt')" id="cm-alt" title="Color by altitude">ALT</button>
    <button onclick="setCM('speed')" id="cm-speed" title="Color by speed">SPD</button>
  </div>
  <div id="label-modes">
    <button class="active" onclick="setLM('alt')" id="lm-alt" title="Show altitude on labels">в†• ALT</button>
    <button onclick="setLM('dist')" id="lm-dist" title="Show distance on labels">в†” DIST</button>
  </div>
  <button id="ac-map-btn" class="active" onclick="toggleAcMap()" title="Show aircraft on map">вњ€ AC</button>
  <button id="mesh-map-btn" onclick="toggleMeshyMap()" title="Show Meshtastic nodes on map">в¬Ў MESH</button>
  <div id="topbar-spacer"></div>
  <div id="topbar-right">
    <button class="topbtn" id="log-btn" onclick="toggleLog()" title="Toggle serial log panel">Log</button>
    <button class="topbtn" id="files-btn" onclick="toggleFiles()" title="Browse SD card files">Files</button>
    <button class="topbtn" id="meshy-btn" onclick="toggleMeshy()" title="Meshtastic messages and nodes">Meshy</button>
    <button id="csv-btn" onclick="document.getElementById('csv-file').click()" title="Load ADS-B CSV log from file">Load CSV</button>
    <input type="file" id="csv-file" accept=".csv" multiple style="display:none" onchange="loadCSV(this)">
    <button class="topbtn" id="flash-btn" onclick="toggleFlash()" title="Flash firmware to device">Flash<span id="flash-badge"></span></button>
    <button class="topbtn" id="screenshot-btn" onclick="takeScreenshot()" title="Save device screenshot">рџ“ё</button>
    <button id="connect-btn" onclick="toggleSerial()" title="Connect to device via WebSerial">Connect Serial</button>
  </div>
</div>
<div id="timeline">
  <button id="tl-play" onclick="tlToggle()" title="Play/pause CSV timeline">в–¶</button>
  <button onclick="tlSpeed(-1)" title="Slow down playback">в€’</button>
  <span class="tl-speed" id="tl-speed">1Г—</span>
  <button onclick="tlSpeed(1)" title="Speed up playback">+</button>
  <input type="range" id="tl-scrub" min="0" max="1000" value="0" oninput="tlScrub(this.value)">
  <span class="tl-time" id="tl-time">--:--:--</span>
  <button onclick="tlClose()" title="Close timeline">вњ•</button>
</div>
<div id="gnss-info"><span style="color:var(--text-dim)">Last: </span><span id="gnss-utc" title="Device UTC clock" class="utc-none">--:--:-- UTC</span><br><span title="GPS receiver status and satellite count">RX: <span id="gnss-status" class="nofix">No fix</span></span><br><span id="gnss-detail" title="Horizontal dilution of precision and receiver coordinates"></span>
<div id="sd-info">SD: <div id="sd-logs"></div></div>
</div>
<div id="detail-wrap"></div>
<div id="session-panel"></div>
<div id="log-panel">
  <div id="log-header"><span>Serial Log</span><div style="display:flex;gap:4px"><button onclick="clearLog()" title="Clear log">вЊ«</button><button onclick="toggleLog()" title="Close log panel">вњ•</button></div></div>
  <div id="log-controls">
    <label><input type="checkbox" id="f-a" checked onchange="refilterLog()"> ADS-B</label>
    <label><input type="checkbox" id="f-g" checked onchange="refilterLog()"> GNSS</label>
    <label><input type="checkbox" id="f-m" checked onchange="refilterLog()"> Meshy</label>
    <label><input type="checkbox" id="f-o" checked onchange="refilterLog()"> Other</label>
    <label><input type="checkbox" id="f-s" checked> Live</label>
  </div>
  <div id="log-output"></div>
</div>
<div id="meshy-panel">
  <div id="meshy-header"><span>Meshy</span><div style="display:flex;gap:4px"><button onclick="clearMeshy()" title="Clear messages">вЊ«</button><button onclick="toggleMeshy()" title="Close Meshy panel">вњ•</button></div></div>
  <div id="meshy-stats">Waiting for data...</div>
  <div id="meshy-controls">
    <label><input type="checkbox" id="mf-text" checked onchange="refilterMeshy()"> Text</label>
    <label><input type="checkbox" id="mf-join" checked onchange="refilterMeshy()"> Joins</label>
    <label><input type="checkbox" id="mf-pos" checked onchange="refilterMeshy()"> Position</label>
    <label><input type="checkbox" id="mf-telem" checked onchange="refilterMeshy()"> Telemetry</label>
  </div>
  <div id="meshy-output"></div>
  <div id="meshy-tx-bar">
    <input type="text" id="meshy-tx-input" placeholder="Send message..." maxlength="230" autocomplete="off" onkeydown="if(event.key==='Enter')meshyTxSend()">
    <button id="meshy-tx-btn" onclick="meshyTxSend()" title="Send Meshtastic broadcast message">Send</button>
  </div>
</div>
<div id="legend">
  <div class="ltitle" id="leg-title">Altitude</div>
  <div class="lbar" id="leg-bar"></div>
  <div class="lrange"><span id="leg-lo">0</span><span id="leg-hi">45,000 ft</span></div>
</div>
<div id="zoom-ctrl">
  <button onclick="zoomSel(-1)" title="Zoom out">в€’</button>
  <button onclick="zoomSel(1)" title="Zoom in">+</button>
</div>
<div id="files-panel">
  <div id="files-header">
    <span>SD Card Files</span>
    <div style="display:flex;gap:4px">
      <button onclick="filesRefresh()" title="Refresh">в†»</button>
      <button onclick="toggleFiles()" title="Close">вњ•</button>
    </div>
  </div>
  <div id="files-path">/sdcard</div>
  <div id="files-status"></div>
  <div id="files-list"></div>
</div>
<div id="flash-overlay" onclick="toggleFlash()"></div>
<div id="flash-panel">
  <div id="flash-header"><span>Firmware Update</span><div style="display:flex;align-items:center;gap:8px"><span style="font-size:10px;color:var(--text-dim);font-weight:400;text-transform:none;letter-spacing:0">ADS-B Scope v1.0.6</span><button onclick="toggleFlash()" title="Close firmware panel">вњ•</button></div></div>
  <div id="flash-body">
    <div class="flash-row"><span class="fl">Device Version</span><span class="fv" id="flash-dev-ver">вЂ“</span></div>
    <div class="flash-row"><span class="fl">Latest Version</span><span class="fv" id="flash-latest-ver">вЂ“</span></div>
    <div class="flash-row"><span class="fl">Firmware URL</span><span class="fv" id="flash-fw-url" style="font-size:10px;word-break:break-all">latest.bin</span></div>
    <div class="flash-row"><span class="fl">Status</span><span class="fv" id="flash-status">Ready</span></div>
    <div id="flash-progress">
      <div id="flash-progress-bar"><div id="flash-progress-fill"></div></div>
      <div id="flash-progress-text">0%</div>
    </div>
    <div id="flash-log"></div>
    <div id="flash-actions">
      <button class="flash-btn secondary" onclick="document.getElementById('flash-file').click()" title="Select a local firmware binary">Local .bin</button>
      <input type="file" id="flash-file" accept=".bin" style="display:none" onchange="flashLocalFile(this)">
      <button class="flash-btn primary" id="flash-go-btn" onclick="startFlash()" title="Download and flash latest firmware">Flash Latest</button>
    </div>
  </div>
</div>
<div id="map"></div>
<div id="panel">
  <div id="panel-drag"></div>
  <button id="panel-toggle" onclick="togglePanel()" title="Show/hide aircraft table">в–І Aircraft в–І</button>
  <div id="panel-scroll" tabindex="0">
  <table id="ac-table"><thead><tr><th onclick="tblSort('icao')">ICAO <span id="sh-icao"></span></th><th onclick="tblSort('cs')">Callsign <span id="sh-cs"></span></th><th onclick="tblSort('alt')">Alt <span id="sh-alt"></span></th><th onclick="tblSort('spd')">Spd <span id="sh-spd"></span></th><th onclick="tblSort('hdg')">Hdg <span id="sh-hdg"></span></th><th onclick="tblSort('vr')">V/S <span id="sh-vr"></span></th><th onclick="tblSort('dist')">Dist <span id="sh-dist"></span></th><th onclick="tblSort('brg')">Brg <span id="sh-brg"></span></th><th onclick="tblSort('age')">Age <span id="sh-age"></span></th><th onclick="tblSort('msgs')">Msgs <span id="sh-msgs"></span></th></tr></thead><tbody id="ac-tbody"></tbody></table>
  </div>
</div>
<script>
const SCOPE_VERSION='1.0.5';
const A=new Map();let rxP=null,map,rxM,rxR=[],rxRL=[],meshyR=[],meshyRL=[],port,reader,conn=false,totM=0,mTs=[],logN=0,selSet=new Set(),cMode='mono',lMode='alt';
let sessStart=null,sessEnd=null; // session timestamps
let consoleReady=false; // set when firmware prints "Serial console ready"
let rxTrail=[],rxTrailLine=null; // receiver position history [{lat,lon,ts}]
let deviceUtcMs=null; // latest UTC from device serial timestamps
let lastSerialMs=0;  // browser time of last serial line received
const icaoDb=new Map(); // aircraft DB cache: icao в†’ {reg,tc,mfr,model,owner,op}
const EXP=180000,LMAX=1000;

// Haversine distance in nm between two lat/lon points
function distNm(lat1,lon1,lat2,lon2){
  const R=3440.065;// earth radius in nm
  const dLat=(lat2-lat1)*Math.PI/180,dLon=(lon2-lon1)*Math.PI/180;
  const a=Math.sin(dLat/2)**2+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
  return 2*R*Math.asin(Math.sqrt(a));
}

// --- Color ---
function acCol(ic,ac){
  if(cMode==='mono')return'#00e5a0';
  if(cMode==='rainbow'){let h=0;for(let i=0;i<ic.length;i++)h=(h*31+ic.charCodeAt(i))&0xFFFF;return`hsl(${h%360},85%,60%)`}
  if(cMode==='alt'){const a=Math.min(Math.max(ac.alt||0,0),45000);return`hsl(${240-(a/45000)*240},85%,55%)`}
  if(cMode==='speed'){const s=Math.min(Math.max(ac.speed||0,0),500);return`hsl(${120-(s/500)*120},85%,55%)`}
  return'#00e5a0';
}
// Per-segment trail color from recorded alt/speed (returns null for modes with uniform trail color)
function ptCol(alt,speed){
  if(cMode==='alt'){const a=Math.min(Math.max(alt||0,0),45000);return`hsl(${240-(a/45000)*240},85%,55%)`}
  if(cMode==='speed'){const s=Math.min(Math.max(speed||0,0),500);return`hsl(${120-(s/500)*120},85%,55%)`}
  return null;
}
// Z-index: selected=10000, others sorted by color mode key
function acZ(ic,ac){
  if(selSet.has(ic))return 10000;
  if(cMode==='alt')return Math.min(Math.max(ac.alt||0,0),45000)/5;  // 0-9000
  if(cMode==='speed')return Math.min(Math.max(ac.speed||0,0),500)*10;  // 0-5000
  if(cMode==='rainbow'){let h=0;for(let i=0;i<ic.length;i++)h=(h*31+ic.charCodeAt(i))&0xFFFF;return h%1000}
  return 0;
}
function setCM(m){
  cMode=m;
  document.querySelectorAll('#color-modes button').forEach(b=>b.classList.remove('active'));
  document.getElementById('cm-'+m)?.classList.add('active');
  const lg=document.getElementById('legend');
  if(m==='alt'){
    lg.classList.add('visible');
    document.getElementById('leg-title').textContent='Altitude';
    document.getElementById('leg-bar').style.background='linear-gradient(90deg,hsl(240,85%,55%),hsl(180,85%,55%),hsl(120,85%,55%),hsl(60,85%,55%),hsl(0,85%,55%))';
    document.getElementById('leg-lo').textContent='0 ft';
    document.getElementById('leg-hi').textContent='45,000 ft';
  }else if(m==='speed'){
    lg.classList.add('visible');
    document.getElementById('leg-title').textContent='Speed';
    document.getElementById('leg-bar').style.background='linear-gradient(90deg,hsl(120,85%,55%),hsl(60,85%,55%),hsl(0,85%,55%))';
    document.getElementById('leg-lo').textContent='0 kt';
    document.getElementById('leg-hi').textContent='500 kt';
  }else{
    lg.classList.remove('visible');
  }
  for(const[i,a]of A)updAc(i,a);
}

function setLM(m){
  lMode=m;
  document.querySelectorAll('#label-modes button').forEach(b=>b.classList.remove('active'));
  document.getElementById('lm-'+m)?.classList.add('active');
  for(const[i,a]of A)updAc(i,a);
  // Refresh meshy labels (markers + peeks) for new label mode
  for(const id in meshyMarkers){
    if(meshyMarkers[id].lb&&!meshyMsgBubbles[id])
      meshyMarkers[id].lb.setIcon(meshyNodeLabel(id));
  }
  for(const id in meshyPeeks){
    if(meshyPeeks[id].lb&&!meshyMsgBubbles[id])
      meshyPeeks[id].lb.setIcon(meshyNodeLabel(id));
  }
}

// --- Map ---
function initMap(){
  map=L.map('map',{center:[37.83,-122.27],zoom:11,zoomControl:false,attributionControl:false});
  L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',{maxZoom:19}).addTo(map);
  map.on('zoom',()=>updRxRings());
  map.on('dragend',()=>{map._userMoved=true});
}
// Zoom anchored to selected aircraft (or map center if none selected)
function zoomSel(dir){
  if(selSet.size===1){
    const ic=[...selSet][0];
    const ac=A.get(ic);
    if(ac&&ac.hasPos&&!ac.expired){
      const pt=L.latLng(ac.lat,ac.lon);
      map.setZoomAround(pt,map.getZoom()+dir);
      return;
    }
  }
  if(dir>0)map.zoomIn();else map.zoomOut();
}

// --- Aircraft ---
function nowTime(){
  if(csvRows.length&&csvNow)return csvNow;
  // Freeze time when disconnected вЂ“ ages stop, display stays introspectable
  if(!conn&&sessEnd)return sessEnd.getTime();
  return Date.now();
}
function acStale(ac,sel){
  const age=nowTime()-ac.ls;
  if(age<30000)return{opacity:1,gray:false};      // fresh
  if(age<60000)return{opacity:0.5,gray:false};     // dimming
  // Selected stale aircraft stay more visible
  if(sel)return{opacity:0.55,gray:true};
  return{opacity:0.35,gray:true};                   // stale/gray
}
function mkIcon(h,c,sel,st,ic){
  const s=sel?24:18;
  const col=st?.gray?(sel?'#99a':'#667'):c;
  const op=st?st.opacity:1;
  const g=sel?`filter:drop-shadow(0 0 8px ${col})drop-shadow(0 0 3px #fff);`:`filter:drop-shadow(0 0 4px ${col}55);`;
  const db=ic?icaoDb.get(ic):null;
  const isHeli=db&&db.cls==='H';
  if(h==null){
    // No heading data вЂ“ show a dot
    return L.divIcon({html:`<div style="display:flex;align-items:center;justify-content:center;width:${s}px;height:${s}px;font-size:${Math.round(s*0.5)}px;color:${col};opacity:${op};${g}">в—Џ</div>`,iconSize:[s,s],iconAnchor:[s/2,s/2],className:''});
  }
  if(isHeli){
    // Helicopter top-down silhouette (facing east like вњ€, rotated by heading)
    // Body/nose at right, tail boom extends left, rotor blades cross through body
    const r=h-90;
    return L.divIcon({html:`<div style="display:flex;align-items:center;justify-content:center;width:${s}px;height:${s}px;opacity:${op};${g}"><svg width="${s}" height="${s}" viewBox="0 0 24 24" style="transform:rotate(${r}deg)"><g fill="none" stroke="${col}" stroke-width="1.3" stroke-linecap="round"><ellipse cx="14" cy="12" rx="5" ry="2.2" fill="${col}" stroke="none"/><line x1="9" y1="12" x2="3" y2="12"/><line x1="3" y1="9" x2="3" y2="15"/><line x1="20" y1="5.5" x2="8" y2="18.5" opacity="0.7"/><line x1="20" y1="18.5" x2="8" y2="5.5" opacity="0.7"/></g></svg></div>`,iconSize:[s,s],iconAnchor:[s/2,s/2],className:''});
  }
  return L.divIcon({html:`<div style="display:flex;align-items:center;justify-content:center;width:${s}px;height:${s}px;font-size:${s}px;color:${col};opacity:${op};${g}"><div style="transform:rotate(${h-90}deg);line-height:1">вњ€</div></div>`,iconSize:[s,s],iconAnchor:[s/2,s/2],className:''});
}
function mkLbl(ic,ac,c,st){
  const sel=selSet.has(ic)?'sel':'';
  const col=st?.gray?(sel?'#99a':'#667'):c;
  const op=st?st.opacity:1;
  const info=lMode==='dist'?(ac.dist!=null?ac.dist.toFixed(1)+'nm':''):(ac.alt?ac.alt+'ft':'');
  const name=ac.cs||ic;
  return L.divIcon({html:`<div class="ac-label ${sel}" style="color:${col};opacity:${op}" onclick="sel0('${ic}',event)">${name}${info?' '+info:''}</div>`,iconSize:[0,0],iconAnchor:[-14,6],className:''});
}
// Compute heading from last two trail points when ADS-B heading is unavailable
function trailHdg(ac){
  if(!ac.trPts||ac.trPts.length<2)return null;
  const pts=ac.trPts;
  const a=pts[pts.length-2],b=pts[pts.length-1];
  const dLon=(b.lng-a.lng)*Math.PI/180;
  const lat1=a.lat*Math.PI/180,lat2=b.lat*Math.PI/180;
  const y=Math.sin(dLon)*Math.cos(lat2);
  const x=Math.cos(lat1)*Math.sin(lat2)-Math.sin(lat1)*Math.cos(lat2)*Math.cos(dLon);
  const brg=(Math.atan2(y,x)*180/Math.PI+360)%360;
  return Math.round(brg);
}

// Rebuild trail as per-segment polylines colored by recorded alt/speed
function rebuildTrail(ic,ac,sel,st,tw,to){
  if(!ac.tr)return;
  ac.tr.clearLayers();
  const pts=ac.trPts;
  if(!pts||pts.length<2)return;
  const grayCol=sel?'#889':'#556';
  const baseCol=st.gray?grayCol:acCol(ic,ac);
  const perSeg=!st.gray&&(cMode==='alt'||cMode==='speed');
  for(let i=1;i<pts.length;i++){
    const p=pts[i-1],q=pts[i];
    const segC=perSeg?(ptCol(q.alt,q.speed)||baseCol):baseCol;
    ac.tr.addLayer(L.polyline([[p.lat,p.lng],[q.lat,q.lng]],{color:segC,weight:tw,opacity:to,interactive:false}));
  }
  ac._trCM=cMode;ac._trGray=st.gray;ac._trSel=sel;ac._trTw=tw;ac._trTo=to;ac._trLen=pts.length;
}

function appendTrailSeg(ic,ac,sel,st,tw,to){
  const pts=ac.trPts;
  if(!pts||pts.length<2)return;
  const grayCol=sel?'#889':'#556';
  const baseCol=st.gray?grayCol:acCol(ic,ac);
  const perSeg=!st.gray&&(cMode==='alt'||cMode==='speed');
  const p=pts[pts.length-2],q=pts[pts.length-1];
  const segC=perSeg?(ptCol(q.alt,q.speed)||baseCol):baseCol;
  ac.tr.addLayer(L.polyline([[p.lat,p.lng],[q.lat,q.lng]],{color:segC,weight:tw,opacity:to,interactive:false}));
  ac._trLen=pts.length;
}

function updAc(ic,ac){
  const sel=selSet.has(ic);
  if(!acMapVisible||!ac.hasPos||(ac.expired&&!sel))return;
  const st=acStale(ac,sel);
  const c=acCol(ic,ac),tw=sel?2.5:1.5;
  const to=sel?Math.max(st.opacity,0.8):(st.gray?0.2:st.opacity*0.6);
  const hdg=ac.hdg!=null?ac.hdg:trailHdg(ac);
  if(!ac.mk){
    ac.mk=L.marker([ac.lat,ac.lon],{icon:mkIcon(hdg,c,sel,st,ic)}).addTo(map);
    ac.tr=L.layerGroup().addTo(map);
    if(!ac.trPts)ac.trPts=[];
    ac.lb=L.marker([ac.lat,ac.lon],{icon:mkLbl(ic,ac,c,st),interactive:true}).addTo(map);
    ac.lb.on('click',(e)=>sel0(ic,e.originalEvent));
    ac.mk.on('click',(e)=>sel0(ic,e.originalEvent));
  }else{
    ac.mk.setLatLng([ac.lat,ac.lon]).setIcon(mkIcon(hdg,c,sel,st,ic));
    ac.lb.setLatLng([ac.lat,ac.lon]).setIcon(mkLbl(ic,ac,c,st));
  }
  const z=acZ(ic,ac);
  ac.mk.setZIndexOffset(z);
  ac.lb.setZIndexOffset(z);
  if(!ac.trPts)ac.trPts=[];
  const pts=ac.trPts,la=pts.length?pts[pts.length-1]:null;
  let added=false;
  if(!la||la.lat!==ac.lat||la.lng!==ac.lon){
    pts.push({lat:ac.lat,lng:ac.lon,alt:ac.alt,speed:ac.speed});
    added=true;
  }
  const prevLen=added?pts.length-1:pts.length;
  const needRebuild=!ac._trCM||ac._trCM!==cMode||ac._trGray!==st.gray
    ||ac._trSel!==sel||ac._trTw!==tw||ac._trTo!==to
    ||ac._trLen!==prevLen;
  if(needRebuild){
    rebuildTrail(ic,ac,sel,st,tw,to);
  }else if(added&&pts.length>=2){
    appendTrailSeg(ic,ac,sel,st,tw,to);
  }
}
function rmAc(ac){if(ac.mk)map.removeLayer(ac.mk);if(ac.lb)map.removeLayer(ac.lb);if(ac.tr)map.removeLayer(ac.tr)}

// --- Selection ---
// Remove map layers for expired aircraft that lost selection
function cleanExpired(){for(const[ic,ac]of A){if(ac.expired&&!selSet.has(ic)&&ac.mk){rmAc(ac);ac.mk=null;ac.lb=null;ac.tr=null}}}
function sel0(ic,ev){
  const multi=ev&&(ev.metaKey||ev.shiftKey||ev.ctrlKey);
  if(multi){
    if(selSet.has(ic))selSet.delete(ic);else selSet.add(ic);
  }else{
    selSet.clear();selSet.add(ic);
  }
  cleanExpired();
  for(const[i,a]of A)updAc(i,a);
  updDet();
  // Sync keyboard focus to clicked row
  const rows=document.querySelectorAll('#ac-tbody tr');
  for(let j=0;j<rows.length;j++){if(rows[j].dataset.ic===ic){kbFocusIdx=j;break}}
  kbApplyFocus();
}
function deselOne(ic){selSet.delete(ic);cleanExpired();for(const[i,a]of A)updAc(i,a);updDet()}
function desel(){selSet.clear();cleanExpired();updDet();for(const[i,a]of A)updAc(i,a)}
function dismissAc(ic,ev){
  ev.stopPropagation();
  selSet.delete(ic);
  const ac=A.get(ic);
  if(ac){ac.pinned=false;rmAc(ac);ac.mk=null;ac.lb=null;ac.tr=null}
  for(const[i,a]of A)updAc(i,a);
  updDet();
}
function updDet(){
  const wrap=document.getElementById('detail-wrap');
  wrap.classList.toggle('visible',selSet.size>0);
  if(!selSet.size){wrap.innerHTML='';return}
  wrap.innerHTML=[...selSet].map(ic=>{
    const ac=A.get(ic);
    if(!ac){selSet.delete(ic);return''}
    const c=acCol(ic,ac);
    const vrText=ac.vr?(ac.vr>0?'+':'')+ac.vr+' fpm':'---';
    const vrCls=ac.vr>0?'up':ac.vr<0?'dn':'';
    const pos=ac.hasPos?`${Math.abs(ac.lat).toFixed(4)}В°${ac.lat>=0?'N':'S'} ${Math.abs(ac.lon).toFixed(4)}В°${ac.lon>=0?'E':'W'}`:'---';
    const db=icaoDb.get(ic);
    return`<div class="det-card">
      <div class="dh"><div><span class="dcs" style="color:${c}">${ac.cs||'---'}</span> <span class="dicao">${ic}</span></div><button class="dx" title="Deselect aircraft" onclick="deselOne('${ic}')">вњ•</button></div>
      ${db?`<div class="dr"><span class="dl">Reg</span><span class="dv">${db.reg||'---'}</span></div>
      <div class="dr"><span class="dl">Type</span><span class="dv">${db.tc?db.tc+(db.model?' вЂ“ '+db.model:''):'---'}</span></div>
      ${db.owner?`<div class="dr"><span class="dl">Owner</span><span class="dv">${db.owner}</span></div>`:''}
      ${db.op?`<div class="dr"><span class="dl">Operator</span><span class="dv">${db.op}</span></div>`:''}`:''}
      <div class="dr"><span class="dl">Altitude</span><span class="dv">${ac.alt!=null?ac.alt.toLocaleString()+' ft':'---'}</span></div>
      <div class="dr"><span class="dl">Speed</span><span class="dv">${ac.speed?ac.speed+' kt':'---'}</span></div>
      <div class="dr"><span class="dl">Heading</span><span class="dv">${ac.hdg!=null?ac.hdg+'В°':'---'}</span></div>
      <div class="dr"><span class="dl">V/S</span><span class="dv ${vrCls}">${vrText}</span></div>
      <div class="dr"><span class="dl">Position</span><span class="dv">${pos}</span></div>
      <div class="dr"><span class="dl">Range</span><span class="dv">${ac.dist!=null?ac.dist.toFixed(1)+' nm':'---'}</span></div>
      <div class="dr"><span class="dl">Bearing</span><span class="dv">${ac.brg!=null?ac.brg+'В°':'---'}</span></div>
    </div>`;
  }).join('');
}

// --- Parse ---
const GR=/GNSS: fix=(\w+) lat=([\d.-]+) lon=([\d.-]+) sats=(\d+) hdop=([\d.]+) q=(-?\d+)/;
const MR=/^[\[(].+?[\])] ([0-9A-F]{6})\s*/;
const AR=/\s(-?\d+)ft/,SR=/\s(\d+)kt\s+(\d+)В°/,VR=/\s([+-]\d+)fpm/;
const PR=/\((\d+\.\d+)([NS]),(\d+\.\d+)([EW])\)/,DR=/(\d+\.\d+)nm@(\d+)В°/;

function parse(l){
  // Detect device reboot вЂ“ reset all status indicators, expire all aircraft
  if(/^ESP-ROM:|^rst:0x/.test(l)){
    updSD('card','wait',null);
    rxP=null;deviceUtcMs=null;
    if(rxTrailLine){map.removeLayer(rxTrailLine);rxTrailLine=null;}
    rxTrail=[];
    updGnss();
    for(const[ic,ac]of A){if(!ac.expired){rmAc(ac);ac.expired=true}}
    selSet.clear();
    deviceVersion='';updFlashVer();
    consoleReady=false;
    meshyConfig={};
  }
  // Parse device version from boot log
  const verM=/App version:\s+(\S+)/.exec(l);
  if(verM){
    deviceVersion=verM[1];
    updFlashVer();
    const match=versionsMatch();
    if(match===false)addLog('[scope] вљ  Firmware update available: device='+deviceVersion+' latest='+latestVersion.version);
    else if(match===true)addLog('[scope] Firmware is up to date ('+deviceVersion+')');
  }
  const ctM=/Compile time:\s+(.+)/.exec(l);
  if(ctM){
    const el=document.getElementById('flash-dev-ver');
    if(el&&deviceVersion)el.textContent=deviceVersion+' ('+ctM[1].trim()+')';
  }
  // SD card status вЂ“ distinguish ADS-B vs Meshy log events
  if(/Failed to reopen/.test(l)){
    const isMeshy=/meshy/i.test(l);
    const fn=l.match(/(\/\S+\.csv)/);
    updSD(isMeshy?'meshy':'adsb','lost',fn?fn[1]:null);
  }else if(/Failed.*open meshy SD log/.test(l)){
    updSD('meshy','fail',null);
  }else if(/Failed.*open SD log/.test(l)){
    updSD('adsb','fail',null);
  }else if(/failed to mount filesystem|sdmmc_card_init failed|Sdmmc_Init fail/.test(l)){
    updSD('card','no-card',null);
  }else if(/SD mount attempt (\d+) failed/.test(l)){
    const m=l.match(/attempt (\d+)/);
    updSD('card','retrying',m?m[1]:null);
  }else if(/Meshy SD log renamed:/.test(l)){
    const fn=l.match(/в†’ (\/\S+)/);
    updSD('meshy',true,fn?fn[1]:null);
  }else if(/SD log renamed:/.test(l)){
    const fn=l.match(/в†’ (\/\S+)/);
    updSD('adsb',true,fn?fn[1]:null);
  }else if(/Meshy SD log: \//.test(l)){
    const fn=l.match(/Meshy SD log: (\/\S+)/);
    updSD('meshy',true,fn?fn[1]:null);
  }else if(/SD log: \//.test(l)){
    const fn=l.match(/SD log: (\/\S+)/);
    updSD('adsb',true,fn?fn[1]:null);
  }else if(/filesystem mounted/.test(l)){
    updSD('card','mounted',null);
  }
  const gm=GR.exec(l);
  if(gm){const la=parseFloat(gm[2]),lo=parseFloat(gm[3]);if(gm[1]==='A'&&la&&lo){const dts=parseDeviceTs(l)||Date.now();rxP={lat:la,lon:lo,sats:parseInt(gm[4]),hdop:parseFloat(gm[5]),fix:true,ts:dts};const prev=rxTrail.length?rxTrail[rxTrail.length-1]:null;if(!prev||prev.lat!==la||prev.lon!==lo){rxTrail.push({lat:la,lon:lo,ts:dts})}updRx();if(!map._p&&!map._userMoved){map.setView([la,lo],11);map._p=true}if(meshyConfig.node)updateNodePosition(meshyConfig.node,la,lo,0)}updGnss();return}
  // Aircraft DB cache вЂ” parse ICAO: lines from firmware
  const icaoM=/ICAO: ([0-9A-F]{6})\|([^|]*)\|([^|]*)\|([^|]*)\|([^|]*)\|([^|]*)\|([^|]*)(?:\|([^|]*))?/.exec(l);
  if(icaoM){icaoDb.set(icaoM[1],{reg:icaoM[2],tc:icaoM[3],mfr:icaoM[4],model:icaoM[5],owner:icaoM[6],op:icaoM[7],cls:icaoM[8]||'?'});if(selSet.has(icaoM[1]))updDet();return}
  const mm=MR.exec(l);if(!mm)return;
  const ic=mm[1],af=l.substring(mm[0].length),cm=af.match(/^([\w]{2,8})\s/),cs=(cm&&/[A-Z]/.test(cm[1]))?cm[1]:null;
  totM++;
  let ac=A.get(ic);
  if(!ac){ac={cs:null,alt:null,speed:null,hdg:null,vr:null,lat:null,lon:null,hasPos:false,expired:false,dist:null,brg:null,ls:Date.now(),msgs:0,mk:null,lb:null,tr:null,trPts:[]};A.set(ic,ac)}
  ac.ls=Date.now();ac.msgs++;if(cs)ac.cs=cs;
  // Revive if expired вЂ“ new message means it's back
  if(ac.expired){ac.expired=false;ac.mk=null;ac.lb=null;ac.tr=null;}
  let m;
  if(m=AR.exec(l))ac.alt=parseInt(m[1]);
  if(m=SR.exec(l)){ac.speed=parseInt(m[1]);ac.hdg=parseInt(m[2])}
  if(m=VR.exec(l))ac.vr=parseInt(m[1]);
  if(m=PR.exec(l)){
    const pLat=parseFloat(m[1])*(m[2]==='S'?-1:1);
    const pLon=parseFloat(m[3])*(m[4]==='W'?-1:1);
    // Sanity: reject positions at exactly 0,0 or clearly outside CONUS/nearby
    if(Math.abs(pLat)>0.1&&Math.abs(pLon)>0.1){
      ac.lat=pLat;ac.lon=pLon;ac.hasPos=true;
    }
  }
  if(m=DR.exec(l)){ac.dist=parseFloat(m[1]);ac.brg=parseInt(m[2])}
  updAc(ic,ac);if(selSet.has(ic))updDet();
  const n=Date.now();mTs.push(n);while(mTs.length&&mTs[0]<n-5000)mTs.shift();
}

// --- RX ---
const RING_NMS=[1,2,5,10,25,50,100,150,200];
function updRx(){
  if(!rxP)return;
  if(!rxM){
    rxM=L.circleMarker([rxP.lat,rxP.lon],{radius:5,color:'#00e5a0',fillColor:'#00e5a0',fillOpacity:0.8,weight:2}).addTo(map).bindPopup('Receiver');
    RING_NMS.forEach(nm=>{
      const c=L.circle([rxP.lat,rxP.lon],{radius:nm*1852,color:'rgba(0,229,160,0.3)',fillColor:'transparent',weight:1.5}).addTo(map);
      rxR.push(c);
      const latOffset=nm*1852/111320;
      const lbl=L.marker([rxP.lat+latOffset,rxP.lon],{interactive:false,icon:L.divIcon({
        html:`<div style="color:rgba(0,229,160,0.5);font-family:JetBrains Mono,monospace;font-size:10px;white-space:nowrap;text-align:center;pointer-events:none">${nm} nm</div>`,
        iconSize:[0,0],iconAnchor:[0,12],className:''
      })}).addTo(map);
      rxRL.push(lbl);
      // Blue meshy rings (hidden initially)
      const mc=L.circle([rxP.lat,rxP.lon],{radius:nm*1852,color:'rgba(77,171,247,0.3)',fillColor:'transparent',weight:1.5});
      meshyR.push(mc);
      const mlbl=L.marker([rxP.lat+latOffset,rxP.lon],{interactive:false,icon:L.divIcon({
        html:`<div style="color:rgba(77,171,247,0.5);font-family:JetBrains Mono,monospace;font-size:10px;white-space:nowrap;text-align:center;pointer-events:none">${nm} nm</div>`,
        iconSize:[0,0],iconAnchor:[0,12],className:''
      })});
      meshyRL.push(mlbl);
    });
    updRxRings();
  }else{
    rxM.setLatLng([rxP.lat,rxP.lon]);
    RING_NMS.forEach((nm,i)=>{
      rxR[i].setLatLng([rxP.lat,rxP.lon]);
      meshyR[i].setLatLng([rxP.lat,rxP.lon]);
      const latOffset=nm*1852/111320;
      rxRL[i].setLatLng([rxP.lat+latOffset,rxP.lon]);
      meshyRL[i].setLatLng([rxP.lat+latOffset,rxP.lon]);
    });
  }
  // Receiver trail вЂ” shows movement history
  if(rxTrail.length>=2){
    const latlngs=rxTrail.map(p=>[p.lat,p.lon]);
    if(!rxTrailLine){
      rxTrailLine=L.polyline(latlngs,{color:'#00e5a0',weight:2.5,opacity:0.6,dashArray:'1 6',lineCap:'round',interactive:false}).addTo(map);
    }else{
      rxTrailLine.setLatLngs(latlngs);
    }
  }
}
// Show rings only up to the first ring that covers all targets.
// Green = ADS-B aircraft. Blue = Meshtastic nodes (only beyond green).
// Always display at least one green ring if there are any aircraft.
function updRxRings(){
  if(!rxR.length||!rxP)return;

  // Update receiver dot color: green when AC visible, blue when only mesh
  if(rxM){
    const col=(!acMapVisible&&!meshyMapVisible)?'#778899':(!acMapVisible&&meshyMapVisible)?'#4dabf7':'#00e5a0';
    rxM.setStyle({color:col,fillColor:col});
  }

  const MIN_PX=30;
  const metersPerPx=40075016.686/(256*Math.pow(2,map.getZoom()));

  // Find farthest ADS-B aircraft
  let maxAcDist=0;
  for(const[,ac]of A){if(!ac.expired&&ac.dist!=null&&ac.dist>maxAcDist)maxAcDist=ac.dist}

  // Find farthest meshy node (only if mesh map is active)
  let maxMeshDist=0;
  if(meshyMapVisible){
    for(const id in meshyNodes){
      const n=meshyNodes[id];
      if(n.lat!=null)maxMeshDist=Math.max(maxMeshDist,distNm(rxP.lat,rxP.lon,n.lat,n.lon));
    }
  }

  // Green rings: show up to the first ring >= farthest aircraft (only when AC visible)
  let greenShowUpTo=-1;
  if(maxAcDist>0&&acMapVisible){
    for(let i=0;i<RING_NMS.length;i++){
      if(RING_NMS[i]>=maxAcDist){greenShowUpTo=i;break}
      if(i===RING_NMS.length-1)greenShowUpTo=i;
    }
    // Target 3 visible rings вЂ“ extend outward if we'd only show 1 or 2
    // (only when mesh layer is off вЂ“ fusion display keeps rings tight)
    if(!meshyMapVisible){
      let visCount=0;
      for(let i=0;i<=greenShowUpTo;i++){
        if((RING_NMS[i]*1852)/metersPerPx>=MIN_PX)visCount++;
      }
      while(visCount<3&&greenShowUpTo<RING_NMS.length-1){
        greenShowUpTo++;
        if((RING_NMS[greenShowUpTo]*1852)/metersPerPx>=MIN_PX)visCount++;
      }
    }
  }

  // Blue rings: cover meshy range, only beyond green
  let blueShowUpTo=-1;
  if(maxMeshDist>0&&meshyMapVisible){
    for(let i=0;i<RING_NMS.length;i++){
      if(RING_NMS[i]>=maxMeshDist){blueShowUpTo=i;break}
      if(i===RING_NMS.length-1)blueShowUpTo=i;
    }
  }

  // First pass: determine which green rings are visible after size filter
  let anyGreenVisible=false;
  const greenVisible=RING_NMS.map((nm,i)=>{
    const radiusPx=(nm*1852)/metersPerPx;
    const vis=(i<=greenShowUpTo&&radiusPx>=MIN_PX);
    if(vis)anyGreenVisible=true;
    return vis;
  });

  // Guarantee at least one green ring: if all green rings were filtered out,
  // force the outermost green ring to show (it's the most important one)
  if(!anyGreenVisible&&greenShowUpTo>=0){
    greenVisible[greenShowUpTo]=true;
    anyGreenVisible=true;
  }

  // If no green rings visible but aircraft are enabled, promote first blue to green
  let promoteBlueIdx=-1;
  if(!anyGreenVisible&&acMapVisible&&blueShowUpTo>=0){
    for(let i=0;i<=blueShowUpTo;i++){
      const radiusPx=(RING_NMS[i]*1852)/metersPerPx;
      if(radiusPx>=MIN_PX){promoteBlueIdx=i;break}
    }
    // If all blue too small, just show the outermost
    if(promoteBlueIdx<0)promoteBlueIdx=blueShowUpTo;
  }

  RING_NMS.forEach((nm,i)=>{
    const radiusPx=(nm*1852)/metersPerPx;
    const tooSmall=(radiusPx<MIN_PX);

    // Green ring
    const greenVis=greenVisible[i];
    if(greenVis&&!map.hasLayer(rxR[i])){rxR[i].addTo(map);rxRL[i].addTo(map)}
    if(!greenVis&&map.hasLayer(rxR[i])){map.removeLayer(rxR[i]);map.removeLayer(rxRL[i])}

    // Blue ring: visible beyond green, up to meshy range, not too small
    // If promoted to green, hide the blue version and show green instead
    let blueVis=(i<=blueShowUpTo&&i>greenShowUpTo&&!tooSmall);
    if(i===promoteBlueIdx){
      // Promote: show as green, hide blue
      blueVis=false;
      if(!map.hasLayer(rxR[i])){rxR[i].addTo(map);rxRL[i].addTo(map)}
    }
    if(blueVis&&!map.hasLayer(meshyR[i])){meshyR[i].addTo(map);meshyRL[i].addTo(map)}
    if(!blueVis&&map.hasLayer(meshyR[i])){map.removeLayer(meshyR[i]);map.removeLayer(meshyRL[i])}

    // Clean up promoted green ring if no longer promoted
    if(i!==promoteBlueIdx&&!greenVisible[i]&&map.hasLayer(rxR[i])){
      map.removeLayer(rxR[i]);map.removeLayer(rxRL[i]);
    }
  });
}
function updGnss(){
  const s=document.getElementById('gnss-status'),d=document.getElementById('gnss-detail'),u=document.getElementById('gnss-utc');
  if(rxP?.fix){
    s.textContent=`Fix (${rxP.sats} sats)`;s.className='fix';
    const latD=Math.abs(rxP.lat).toFixed(4);
    const latH=rxP.lat>=0?'N':'S';
    const lonD=Math.abs(rxP.lon).toFixed(4);
    const lonH=rxP.lon>=0?'E':'W';
    d.textContent=`HDOP ${rxP.hdop} | ${latD}В°${latH}, ${lonD}В°${lonH}`;
    d.title=`Horizontal dilution of precision: ${rxP.hdop}\nReceiver: ${latD}В°${latH}, ${lonD}В°${lonH}`;
  }
  else{s.textContent='No fix';s.className='nofix';d.textContent='Acquiring...';d.title='Waiting for GPS satellite fix'}
  // UTC clock: gray=no time, green=live, red=stale (>5s no data or disconnected)
  if(!deviceUtcMs){
    u.textContent='--:--:-- UTC';u.className='utc-none';
    u.title='No UTC time received yet';
  }else{
    const dt=new Date(deviceUtcMs);
    const hh=String(dt.getUTCHours()).padStart(2,'0');
    const mm=String(dt.getUTCMinutes()).padStart(2,'0');
    const ss=String(dt.getUTCSeconds()).padStart(2,'0');
    const age=Date.now()-lastSerialMs;
    const stale=!conn||age>5000;
    u.textContent=`${hh}:${mm}:${ss} UTC`;
    u.className=stale?'utc-stale':'utc-live';
    u.title=stale?`Last device time (stale вЂ” ${conn?'no data for '+(age/1000|0)+'s':'disconnected'})`:'Device clock (UTC) from serial data';
  }
}

let sdAdsb={ok:false,file:'',err:''};
let sdMeshy={ok:false,file:'',err:''};
let sdMounted=false;
function updSD(which,ok,path){
  // which: 'adsb', 'meshy', or 'card' (card-level events affect both)
  if(which==='card'){
    if(ok==='mounted'){sdMounted=true;}
    else if(ok==='no-card'||ok==='wait'){sdMounted=false;sdAdsb={ok:false,file:'',err:ok};sdMeshy={ok:false,file:'',err:ok};}
    else if(ok==='retrying'){sdMounted=false;sdAdsb={ok:false,file:'',err:'retry #'+path};sdMeshy={ok:false,file:'',err:'retry #'+path};}
  }else{
    const s=(which==='meshy')?sdMeshy:sdAdsb;
    if(ok===true){s.ok=true;s.file=path?path.replace('/sdcard/',''):'';s.err='';sdMounted=true;}
    else if(ok==='lost'){s.ok=false;s.file='';s.err='lost';}
    else if(ok==='fail'){s.ok=false;s.file='';s.err='fail';}
  }
  renderSD();
}
function renderSD(){
  const el=document.getElementById('sd-logs');
  if(!sdMounted&&!sdAdsb.ok&&!sdMeshy.ok){
    const err=sdAdsb.err||'waiting';
    if(err==='no-card'){el.innerHTML='<span class="sd-err" title="No SD card detected">вњ• no card</span>';return;}
    if(err.startsWith('retry')){el.innerHTML='<span class="sd-err" title="SD card mount failed, retrying">вњ• mount '+err+'</span>';return;}
    el.innerHTML='<span class="sd-wait" title="Waiting for SD card to initialize">waiting</span>';
    return;
  }
  let lines=[];
  if(sdAdsb.ok)lines.push('<span class="sd-ok" title="ADS-B flight log recording to SD card">в—Џ '+esc(sdAdsb.file)+'</span>');
  else if(sdAdsb.err&&sdAdsb.err!=='wait')lines.push('<span class="sd-err" title="Failed to open ADS-B log file on SD card">вњ• adsb log failed</span>');
  else if(sdMounted)lines.push('<span class="sd-wait" title="SD card mounted, waiting for first ADS-B data">в—‹ adsb log pending</span>');
  if(sdMeshy.ok)lines.push('<span class="sd-meshy" title="Meshtastic message log recording to SD card">в—Џ '+esc(sdMeshy.file)+'</span>');
  else if(sdMeshy.err&&sdMeshy.err!=='wait')lines.push('<span class="sd-err" title="Failed to open Meshtastic log file on SD card">вњ• mesh log failed</span>');
  else if(sdMounted)lines.push('<span class="sd-wait" title="SD card mounted, waiting for first Meshtastic packet">в—‹ mesh log pending</span>');
  if(lines.length===0){el.innerHTML='<span class="sd-wait" title="SD card mounted, no logs yet">mounted</span>';return;}
  el.innerHTML=lines.join('<br>');
}

// --- Log ---
let logPaused=[];  // buffer lines while paused
function logType(l){
  if(/^\[scope\]/.test(l))return 'scope';
  if(/\[CONSOLE\]|CONSOLE:|Command mode|Entering log mode|buffered lines replayed/.test(l))return 'console';
  if(/GNSS:/.test(l))return 'gnss';
  if(/MESHY|meshy_|Meshy/.test(l))return 'meshy';
  if(MR.test(l))return 'adsb';
  if(/error|fail/i.test(l))return 'error';
  return 'other';
}
const logCls={adsb:'log-adsb',gnss:'log-gnss',scope:'log-scope',error:'log-error',other:'log-info',meshy:'log-meshy',console:'log-console'};

function addLog(l){
  const live=document.getElementById('f-s').checked;
  if(!live){logPaused.push(l);if(logPaused.length>LMAX)logPaused.shift();return}
  const el=document.getElementById('log-output');
  if(logPaused.length){for(const pl of logPaused)appendLogLine(el,pl);logPaused=[];}
  appendLogLine(el,l);
  el.scrollTop=el.scrollHeight;
}
function stripAnsi(s){return s.replace(/\x1b\[[0-9;]*[a-zA-Z]/g,'')}
function appendLogLine(el,l){
  l=stripAnsi(l);
  const t=logType(l);
  const d=document.createElement('div');
  d.className=logCls[t]||'log-info';
  d.dataset.lt=t;
  d.textContent=l;
  d.style.display=isTypeVisible(t)?'':'none';
  el.appendChild(d);logN++;
  while(logN>LMAX&&el.firstChild){el.removeChild(el.firstChild);logN--}
}
function isTypeVisible(t){
  if(t==='adsb')return document.getElementById('f-a').checked;
  if(t==='gnss')return document.getElementById('f-g').checked;
  if(t==='meshy')return document.getElementById('f-m').checked;
  if(t==='scope')return true;
  if(t==='console')return true;
  if(t==='error')return true;
  return document.getElementById('f-o').checked;
}
function refilterLog(){
  const lines=document.getElementById('log-output').children;
  for(let i=0;i<lines.length;i++){
    const t=lines[i].dataset.lt;
    lines[i].style.display=isTypeVisible(t)?'':'none';
  }
}
function clearLog(){document.getElementById('log-output').innerHTML='';logN=0;logPaused=[]}
function toggleLog(){document.getElementById('log-panel').classList.toggle('visible');document.getElementById('log-btn').classList.toggle('active');syncPanelLayout()}

// --- Meshy panel ---
const meshyNodes={};  // nodeId -> {short:'', long:''}
let meshyCount=0;
const MESHY_MAX=5000;
const meshyDedup={};  // dedupKey -> {el, receptions:[], count}
const MESHY_DEDUP_WINDOW=120000; // 2min вЂ“ same message within this window merges
let meshyConfig={};   // parsed from MESHY boot log: region, preset, role, freq, node, txPwr, channel
function toggleMeshy(){
  if(csvRows.length&&!hasMeshyCSV){alert('Load a meshy CSV alongside the ADS-B CSV to see Meshtastic messages in replay.');return}
  const p=document.getElementById('meshy-panel');
  p.classList.toggle('visible');
  document.getElementById('meshy-btn').classList.toggle('active');
}
function clearMeshy(){document.getElementById('meshy-output').innerHTML='';meshyCount=0;Object.keys(meshyDedup).forEach(k=>delete meshyDedup[k])}
async function meshyTxSend(){
  const input=document.getElementById('meshy-tx-input');
  const text=input.value.trim();
  if(!text)return;
  if(!conn){alert('Connect serial first');return}
  const btn=document.getElementById('meshy-tx-btn');
  btn.disabled=true;
  try{
    await sendCmdResume('meshy_tx '+text,3000);
  }catch(e){addLog('[scope] TX error: '+e.message)}
  btn.disabled=false;
  input.value='';
  input.focus();
}
async function meshyDlWebapp(){
  if(!conn){alert('Connect serial first');return}
  const st=document.getElementById('files-status');
  st.innerHTML='Downloading webapp...';
  try{
    const raw=await sendCmdResume('webapp',15000);
    const blob=new Blob([raw],{type:'text/html'});const url=URL.createObjectURL(blob);
    const a=document.createElement('a');a.href=url;a.download='adsb_scope.htm';document.body.appendChild(a);a.click();
    document.body.removeChild(a);URL.revokeObjectURL(url);
    st.innerHTML='Webapp downloaded ('+(raw.length/1024).toFixed(0)+' KB)';
  }catch(e){st.innerHTML='Failed: '+e.message}
}
async function takeScreenshot(){
  if(!conn){alert('Connect serial first');return}
  const btn=document.getElementById('screenshot-btn');
  if(btn)btn.textContent='вЏі';
  try{
    // Step 1: Capture screenshot to SD card
    const saveResult=await sendCmd('screenshot',10000);
    if(!saveResult||/failed/i.test(saveResult)){
      addLog('[scope] Screenshot capture failed');
      if(btn)btn.textContent='рџ“ё';
      return;
    }
    addLog('[scope] '+saveResult.trim());
    // Step 2: Send base64 over serial (in command mode вЂ” no interleaving)
    const raw=await sendCmd('screenshot send',30000);
    if(!raw||!raw.includes('SCREENSHOT_BEGIN')){
      addLog('[scope] Screenshot send failed');
      if(btn)btn.textContent='рџ“ё';
      return;
    }
    // Parse: find SCREENSHOT_BEGIN line, collect base64, stop at SCREENSHOT_END
    const lines=raw.split('\n');
    let fname='screenshot.png',b64='',capture=false;
    for(const line of lines){
      const clean=line.trim();
      if(clean.startsWith('SCREENSHOT_BEGIN')){
        const parts=clean.split(/\s+/);
        fname=parts[1]||'screenshot.png';
        capture=true;continue;
      }
      if(clean.startsWith('SCREENSHOT_END')){capture=false;continue;}
      if(capture&&clean.length>0&&/^[A-Za-z0-9+/=]+$/.test(clean))b64+=clean;
    }
    if(b64.length===0){
      addLog('[scope] Screenshot: no base64 data received');
      if(btn)btn.textContent='рџ“ё';
      return;
    }
    const bin=Uint8Array.from(atob(b64),c=>c.charCodeAt(0));
    const blob=new Blob([bin],{type:'image/png'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');
    a.href=url;a.download=fname;a.click();
    URL.revokeObjectURL(url);
    addLog('[scope] Screenshot downloaded: '+fname+' ('+bin.length+' bytes)');
  }catch(e){
    addLog('[scope] Screenshot error: '+e.message);
  }finally{
    if(btn)btn.textContent='рџ“ё';
    // Return to log mode вЂ” sendCmd leaves device in command mode
    try{
      cmdWaiting=false;cmdBuf=[];
      await serialWrite('log\n');
    }catch(e){}
  }
}
function handleMeshyTx(l){
  // Parse: MESHY: [TX] !NODEID id:PACKETID "text"
  const m=/MESHY:\s+\[TX\]\s+!([0-9a-fA-F]{8})\s+id:([0-9a-fA-F]{8})\s+"(.+)"/.exec(l);
  if(!m)return;
  const nodeId=m[1];
  const pktId=m[2];
  const text=m[3];
  const displayName=(meshyNodes[nodeId]?.short)||'You';
  const dts=parseDeviceTs(l);
  // Associate our receiver position with our node (backfills older messages too)
  if(rxP&&rxP.fix)updateNodePosition(nodeId,rxP.lat,rxP.lon,0);
  addMeshyMsg({from:displayName,node:nodeId,pktId:pktId,rssi:0,snr:0,hop:0,hopStart:0,kind:'text',text:text,_tx:true,_deviceTs:dts});
}
function handleMeshyConfig(l){
  // Parse: MESHY: Session initialized: node=!XXXXXXXX region=XX preset=XX role=XX tx=XXdBm hop=N slot=auto/manual +Nch
  const sm=/MESHY:\s+Session initialized:\s+node=!(\w+)\s+region=(\w+)\s+preset=(\w+)\s+role=([\w ]+)\s+tx=(\d+)dBm(?:\s+hop=(\d+))?\s+slot=(\w+)\s+\+(\d+)ch/.exec(l);
  if(sm){meshyConfig={node:sm[1],region:sm[2],preset:sm[3],role:sm[4],txPwr:sm[5],hop:sm[6]||'3',slot:sm[7],extraCh:parseInt(sm[8]),freq:meshyConfig.freq||null};learnNodeName(sm[1],'You','ADS-B Scope');if(rxP&&rxP.fix)updateNodePosition(sm[1],rxP.lat,rxP.lon,0);updateMeshyStats();return}
  // Parse: MESHY: Radio configured, listening on 913.125 MHz
  const fm=/MESHY:\s+Radio configured.*?([\d.]+)\s+MHz/.exec(l);
  if(fm){meshyConfig.freq=fm[1];updateMeshyStats();return}
  // Parse: MESHY: Meshy stopped
  if(/MESHY:\s+Meshy stopped/.test(l)){meshyConfig.stopped=true;updateMeshyStats();return}
  // Parse: MESHY: Meshy started
  if(/MESHY:\s+Meshy started/.test(l)){meshyConfig.stopped=false;updateMeshyStats()}
}
function parseMeshyLine(l){
  const m=/MESHY:\s+\[(\w+)\]\s+!([0-9a-fA-F]{8})\s+\(([^)]*)\)\s+id:([0-9a-fA-F]{8})\s+RSSI:([\-\d.]+)\s+SNR:([\-\d.]+)\s+hop:(\d+)\/(\d+)(?:\s+ch:(\w+))?/.exec(l);
  if(!m)return null;
  return{type:m[1],node:m[2],name:m[3]!=='?'?m[3]:'',pktId:m[4],rssi:parseFloat(m[5]),snr:parseFloat(m[6]),hop:parseInt(m[7]),hopStart:parseInt(m[8]),pki:m[9]==='PKI'};
}
let meshyPendingText=null;
let meshyPendingNode=null;
let meshyPendingTelem=null;
function handleMeshyLine(l){
  const qt=/MESHY:\s+"(.+)"/.exec(l);
  if(qt&&meshyPendingText){
    meshyPendingText.text=qt[1];
    addMeshyMsg(meshyPendingText);
    meshyPendingText=null;
    return;
  }
  const pc=/MESHY:\s+pos:([\-\d.]+),([\-\d.]+)\s+alt:([\-\d]+)/.exec(l);
  if(pc&&meshyPendingNode){
    updateNodePosition(meshyPendingNode,parseFloat(pc[1]),parseFloat(pc[2]),parseInt(pc[3]));
    meshyPendingNode=null;
    return;
  }
  const tc=/MESHY:\s+bat:(\d+)%\s+([\d.]+)V\s+chUtil:([\d.]+)%\s+airTx:([\d.]+)%/.exec(l);
  if(tc&&meshyPendingTelem){
    meshyPendingTelem.bat=parseInt(tc[1]);
    meshyPendingTelem.volt=parseFloat(tc[2]);
    meshyPendingTelem.chUtil=parseFloat(tc[3]);
    meshyPendingTelem.airTx=parseFloat(tc[4]);
    addMeshyMsg(meshyPendingTelem);
    meshyPendingTelem=null;
    return;
  }
  meshyPendingNode=null;
  meshyPendingTelem=null;
  const p=parseMeshyLine(l);
  if(!p)return;
  if(p.name)learnNodeName(p.node,p.name);
  const displayName=p.name||(meshyNodes[p.node]?.short)||p.node;
  const dts=parseDeviceTs(l);
  const base={from:displayName,node:p.node,pktId:p.pktId,rssi:p.rssi,snr:p.snr,hop:p.hop,hopStart:p.hopStart,pki:p.pki,_deviceTs:dts};
  if(p.type==='TEXT'){meshyPendingText={...base,kind:'text',text:''};return;}
  if(p.type==='NODE'){addMeshyMsg({...base,kind:'join'});return;}
  if(p.type==='POS'){meshyPendingNode=p.node;addMeshyMsg({...base,kind:'pos'});return;}
  if(p.type==='TELEM'){meshyPendingTelem={...base,kind:'telem',bat:0,volt:0,chUtil:0,airTx:0};return;}
}
function handleMeshyNodeInfo(l){
  const m=/MESHY:\s+Node\s+!([0-9a-fA-F]{8}):\s+(.+?)\s+\((\w+)\)/.exec(l);
  if(m)learnNodeName(m[1],m[3],m[2]);
}
function learnNodeName(nodeId,short,long){
  const prev=meshyNodes[nodeId];
  const n=meshyNodes[nodeId]||{};
  n.short=short;
  if(long)n.long=long;
  meshyNodes[nodeId]=n;
  if(prev?.short===short)return;
  for(const key in meshyDedup){
    const entry=meshyDedup[key];
    if(entry.msg.node===nodeId){entry.msg.from=short;renderMeshyLine(entry)}
  }
  if(n.lat!=null)updateMeshyMapNode(nodeId); // re-render label with new name
}
function updateNodePosition(nodeId,lat,lon,alt){
  const n=meshyNodes[nodeId]||{};
  const hadPos = n.lat != null;
  n.lat=lat;n.lon=lon;n.alt=alt;
  meshyNodes[nodeId]=n;
  updateMeshyMapNode(nodeId);
  // Backfill has_pos on older messages from this node that didn't have position
  if(!hadPos){
    for(const key in meshyDedup){
      const entry=meshyDedup[key];
      if(entry.msg.node===nodeId&&!entry.has_pos){
        entry.has_pos=true;
        renderMeshyLine(entry);
      }
    }
  }
}
// --- Meshy map layer ---
let meshyMapVisible=false;
let acMapVisible=true;
const meshyMarkers={};  // nodeId -> {mk, lb}
function toggleAcMap(){
  acMapVisible=!acMapVisible;
  document.getElementById('ac-map-btn').classList.toggle('active',acMapVisible);
  if(!acMapVisible){
    for(const[,ac]of A){if(ac.mk)rmAc(ac)}
  }else{
    for(const[ic,ac]of A){
      if(ac.hasPos&&(!ac.expired||selSet.has(ic))){ac.mk=null;ac.lb=null;ac.tr=null;updAc(ic,ac)}
    }
  }
  updRxRings();
}
function toggleMeshyMap(){
  if(csvRows.length&&!hasMeshyCSV){alert('Load a meshy CSV alongside the ADS-B CSV to see mesh nodes on the map.');return}
  meshyMapVisible=!meshyMapVisible;
  document.getElementById('mesh-map-btn').classList.toggle('active',meshyMapVisible);
  if(meshyMapVisible){
    // Show all nodes, remove peeks (they're now visible as regular markers)
    hideAllPeeks();
    for(const id in meshyNodes){if(meshyNodes[id].lat!=null)updateMeshyMapNode(id)}
    // Re-apply any active bubbles to the new label markers
    for(const id in meshyMsgBubbles){
      const b=meshyMsgBubbles[id];
      const n=meshyNodes[id];
      if(n){
        const name=n.short||id;
        const bubbleIcon=L.divIcon({html:'<div class="mesh-bubble"><b>'+esc(name)+'</b> '+esc(b.text)+'</div>',iconSize:[0,0],iconAnchor:[-8,4],className:''});
        if(meshyMarkers[id]&&meshyMarkers[id].lb)meshyMarkers[id].lb.setIcon(bubbleIcon);
      }
    }
    // Apply dim state if anything is selected
    dimMeshyNodes();
  }else{
    // Remove all mesh markers
    for(const id in meshyMarkers){
      if(meshyMarkers[id].mk)map.removeLayer(meshyMarkers[id].mk);
      if(meshyMarkers[id].lb)map.removeLayer(meshyMarkers[id].lb);
    }
    Object.keys(meshyMarkers).forEach(k=>delete meshyMarkers[k]);
    // Bubbles map layers are gone with markers, but keep the data so
    // they restore when toggling back on
    // Recreate peeks for any currently selected nodes
    meshySelected.forEach(id=>{
      if(nodeHasPosition(id))showMeshyPeek(id);
    });
    // Re-apply any active message bubbles to the peek labels
    for(const id in meshyMsgBubbles){
      const b=meshyMsgBubbles[id];
      const n=meshyNodes[id];
      if(n&&meshyPeeks[id]&&meshyPeeks[id].lb){
        const name=n.short||id;
        const bubbleIcon=L.divIcon({html:'<div class="mesh-bubble"><b>'+esc(name)+'</b> '+esc(b.text)+'</div>',iconSize:[0,0],iconAnchor:[-8,4],className:''});
        meshyPeeks[id].lb.setIcon(bubbleIcon);
      }
    }
  }
  updRxRings();
}
function meshyNodeIcon(){
  return L.divIcon({html:'<div style="font-size:14px;color:#4dabf7;text-shadow:0 0 6px #4dabf7,0 0 12px rgba(77,171,247,0.4);line-height:1">в¬Ў</div>',iconSize:[14,14],iconAnchor:[7,7],className:''});
}
function meshyNodeLabel(id){
  const n=meshyNodes[id]||{};
  const name=n.short||id;
  let info='';
  if(lMode==='dist'&&rxP&&n.lat!=null){
    info=' '+distNm(rxP.lat,rxP.lon,n.lat,n.lon).toFixed(1)+'nm';
  } else if(lMode==='alt'&&n.alt!=null&&n.alt>0){
    info=' '+n.alt+'m';
  }
  return L.divIcon({html:'<div class="mesh-label">'+esc(name)+info+'</div>',iconSize:[0,0],iconAnchor:[-8,4],className:''});
}
function updateMeshyMapNode(id){
  if(!meshyMapVisible)return;
  const n=meshyNodes[id];
  if(!n||n.lat==null)return;
  const existing=meshyMarkers[id];
  if(existing){
    existing.mk.setLatLng([n.lat,n.lon]);
    existing.lb.setLatLng([n.lat,n.lon]).setIcon(meshyNodeLabel(id));
  }else{
    const mk=L.marker([n.lat,n.lon],{icon:meshyNodeIcon(),interactive:true,zIndexOffset:-100}).addTo(map);
    const lb=L.marker([n.lat,n.lon],{icon:meshyNodeLabel(id),interactive:false,zIndexOffset:-100}).addTo(map);
    mk.bindPopup(()=>{const nn=meshyNodes[id]||{};return'<b>'+(nn.short||id)+'</b>'+(nn.long?' вЂ“ '+nn.long:'')+'<br>'+n.lat.toFixed(5)+', '+n.lon.toFixed(5)+(n.alt?' alt:'+n.alt+'m':'')});
    meshyMarkers[id]={mk,lb};
  }
}
// --- Meshy map message bubbles ---
const meshyMsgBubbles={}; // nodeId -> {mk, ts, text}
const MESHY_MSG_FADE_START=60000;   // start fading after 60s
const MESHY_MSG_FADE_END=120000;    // fully removed after 120s
// Temporary multi-node peek (when mesh layer is off)
const meshyPeeks={}; // nodeId -> {mk, lb}
const meshySelected=new Set(); // currently selected node IDs
let meshyLastClickedEl=null;   // last clicked .meshy-msg element (for shift-range)
function showMeshyPeek(nodeId){
  if(meshyPeeks[nodeId])return; // already peeking
  const n=meshyNodes[nodeId];
  if(!n||n.lat==null)return;
  const mk=L.marker([n.lat,n.lon],{icon:meshyNodeIcon(),interactive:false,zIndexOffset:200}).addTo(map);
  const lb=L.marker([n.lat,n.lon],{icon:meshyNodeLabel(nodeId),interactive:false,zIndexOffset:200}).addTo(map);
  meshyPeeks[nodeId]={mk,lb};
}
function hideMeshyPeek(nodeId){
  const p=meshyPeeks[nodeId];
  if(!p)return;
  map.removeLayer(p.mk);
  map.removeLayer(p.lb);
  delete meshyPeeks[nodeId];
}
function hideAllPeeks(){
  for(const id in meshyPeeks)hideMeshyPeek(id);
}
function meshySelectRange(fromEl,toEl){
  const rows=Array.from(document.querySelectorAll('#meshy-output .meshy-msg'));
  const a=rows.indexOf(fromEl), b=rows.indexOf(toEl);
  if(a<0||b<0)return;
  const lo=Math.min(a,b), hi=Math.max(a,b);
  // Add all nodes in range to selection (don't clear existing)
  for(let i=lo;i<=hi;i++){
    const el=rows[i];
    if(el.style.display==='none')continue; // skip filtered-out rows
    if(el.classList.contains('selected'))continue; // already selected
    const nodeId=el.dataset.node;
    el.classList.add('selected');
    meshySelected.add(nodeId);
    // Show on map
    if(nodeHasPosition(nodeId)){
      if(!meshyMapVisible)showMeshyPeek(nodeId);
      // Find the dedup entry for bubble text
      const key=Object.keys(meshyDedup).find(k=>meshyDedup[k].el===el);
      if(key){
        const m=meshyDedup[key].msg;
        const txt=m.kind==='text'?m.text:m.kind==='join'?m.from+' joined':m.kind;
        showMeshyMapMsg(nodeId,txt);
      }
    }
  }
  if(meshyMapVisible)dimMeshyNodes();
  meshyLastClickedEl=toEl;
}
function meshySelectNode(nodeId,entry,multi){
  const was=entry.el.classList.contains('selected');
  if(!multi)meshyDeselectAll();
  if(was&&!multi){
    // Deselecting this row
    entry.el.classList.remove('selected');
    meshySelected.delete(nodeId);
    if(!meshyMapVisible){hideMeshyPeek(nodeId);removeMeshyBubble(nodeId)}
    else dimMeshyNodes();
    return;
  }
  if(was&&multi){
    // Multi-click on already selected row = deselect it
    entry.el.classList.remove('selected');
    // Only remove node from meshySelected if no other rows from this node are selected
    const still=document.querySelector('.meshy-msg.selected[data-node="'+nodeId+'"]');
    if(!still){
      meshySelected.delete(nodeId);
      if(!meshyMapVisible){hideMeshyPeek(nodeId);removeMeshyBubble(nodeId)}
    }
    if(meshyMapVisible)dimMeshyNodes();
    return;
  }
  meshySelected.add(nodeId);
  entry.el.classList.add('selected');
  const n=meshyNodes[nodeId];
  if(n&&n.lat!=null){
    const m=entry.msg;
    const txt=m.kind==='text'?m.text:m.kind==='join'?m.from+' joined':m.kind;
    if(!meshyMapVisible)showMeshyPeek(nodeId);
    showMeshyMapMsg(nodeId,txt);
    if(meshyMapVisible)dimMeshyNodes();
  }
}
function meshyDeselectAll(){
  meshySelected.forEach(id=>{
    // Remove peek markers for deselected
    if(!meshyMapVisible){hideMeshyPeek(id);removeMeshyBubble(id)}
  });
  meshySelected.clear();
  document.querySelectorAll('.meshy-msg.selected').forEach(el=>el.classList.remove('selected'));
  if(meshyMapVisible)dimMeshyNodes();
}
function removeMeshyBubble(nodeId){
  if(meshyMsgBubbles[nodeId]){
    revertMeshyLabel(nodeId);
    delete meshyMsgBubbles[nodeId];
  }
}
function dimMeshyNodes(){
  // If nothing selected, restore all to full opacity
  if(meshySelected.size===0){
    for(const id in meshyMarkers){
      if(meshyMarkers[id].mk)meshyMarkers[id].mk.setOpacity(1);
      if(meshyMarkers[id].lb)meshyMarkers[id].lb.setOpacity(1);
    }
    return;
  }
  // Dim non-selected, brighten selected
  for(const id in meshyMarkers){
    const sel=meshySelected.has(id);
    if(meshyMarkers[id].mk)meshyMarkers[id].mk.setOpacity(sel?1:0.25);
    if(meshyMarkers[id].lb)meshyMarkers[id].lb.setOpacity(sel?1:0.25);
  }
}
function nodeHasPosition(nodeId){
  const n=meshyNodes[nodeId];
  return n&&n.lat!=null;
}
function showMeshyMapMsg(nodeId,text){
  if(!meshyMapVisible&&!meshyPeeks[nodeId]&&!meshySelected.has(nodeId))return;
  const n=meshyNodes[nodeId];
  if(!n||n.lat==null)return;
  const name=n.short||nodeId;
  // Upgrade the label marker to a bubble (same position, no separate marker)
  const bubbleIcon=L.divIcon({
    html:'<div class="mesh-bubble"><b>'+esc(name)+'</b> '+esc(text)+'</div>',
    iconSize:[0,0],iconAnchor:[-8,4],className:''
  });
  // Find the label marker вЂ“ could be in meshyMarkers (mesh layer on) or meshyPeeks (peek)
  const src=meshyMarkers[nodeId]||meshyPeeks[nodeId];
  if(src&&src.lb)src.lb.setIcon(bubbleIcon);
  // Track bubble state for aging/revert
  const old=meshyMsgBubbles[nodeId];
  meshyMsgBubbles[nodeId]={ts:Date.now(),text,nodeId};
}
function revertMeshyLabel(nodeId){
  // Revert label from bubble back to plain name
  const src=meshyMarkers[nodeId]||meshyPeeks[nodeId];
  if(src&&src.lb)src.lb.setIcon(meshyNodeLabel(nodeId));
}
function ageMeshyMsgBubbles(){
  const now=Date.now();
  for(const id in meshyMsgBubbles){
    const b=meshyMsgBubbles[id];
    const age=now-b.ts;
    if(age>MESHY_MSG_FADE_END){
      revertMeshyLabel(id);
      delete meshyMsgBubbles[id];
    }else if(age>MESHY_MSG_FADE_START){
      const src=meshyMarkers[id]||meshyPeeks[id];
      if(src&&src.lb){
        const op=Math.max(0.3,1-((age-MESHY_MSG_FADE_START)/(MESHY_MSG_FADE_END-MESHY_MSG_FADE_START)));
        src.lb.setOpacity(op);
      }
    }
  }
}
setInterval(ageMeshyMsgBubbles,2000);
function fmtRx(r){
  const hops=r.hopStart>0?(r.hopStart-r.hop):0;
  return `RSSI:${r.rssi} SNR:${r.snr}${hops>0?' +'+hops+'hop':''}${r.hop>0?' relay':' direct'}`;
}
function parseDeviceTs(l){
  // Extract device timestamp from serial line: [2026-03-28 20:45:36.127Z]
  const m=/^\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d+Z)\]/.exec(l);
  if(m)return new Date(m[1].replace(' ','T')).getTime();
  // Boot-relative: [boot+818.793] вЂ” no real UTC available
  return null;
}
function fmtMeshyTime(ts){
  const d=new Date(ts);
  const h=String(d.getHours()).padStart(2,'0');
  const m=String(d.getMinutes()).padStart(2,'0');
  const s=String(d.getSeconds()).padStart(2,'0');
  return h+':'+m+':'+s;
}
function meshyDedupKey(m){
  // Packet-ID-based dedup: matches TX echoes with relay receptions
  if(m.pktId)return m.node+':id:'+m.pktId;
  // Fallback for CSV replay or old logs without packet IDs
  if(m.kind==='text')return m.node+':text:'+m.text;
  return m.node+':'+m.kind;
}
function renderMeshyLine(entry){
  const m=entry.msg;const c=entry.count;const latest=entry.receptions[entry.receptions.length-1];
  const meta=fmtRx(latest);
  const hasPos=entry.has_pos;
  const pin=hasPos?'<span class="ml">\u2299</span>':'';
  const cx=c>1?` <span class="mx" data-expand="1">x${c}</span>`:'';
  const ts=entry.firstTs?`<span class="mts">${fmtMeshyTime(entry.firstTs)}</span>`:'';
  let html='';
  const dm=m.pki?'<span class="mk">DM</span>':'';
  switch(m.kind){
    case'text':html=`${ts}${pin}${dm}<span class="mn">${esc(m.from)}</span> <span class="mt">${esc(m.text)}</span>${cx} <span class="mr">${meta}</span>`;break;
    case'join':html=`${ts}${pin}<span class="mj">${esc(m.from)} joined</span>${cx} <span class="mr">${meta}</span>`;break;
    case'pos':html=`${ts}${pin}<span class="mp">${esc(m.from)} position</span>${cx} <span class="mr">${meta}</span>`;break;
    case'telem':{
      const tv=m.bat?` ${m.bat}% ${m.volt.toFixed(1)}V ch:${m.chUtil.toFixed(0)}% air:${m.airTx.toFixed(0)}%`:'';
      html=`${ts}${pin}<span class="mp">${esc(m.from)}${tv}</span>${cx} <span class="mr">${meta}</span>`;break;
    }
  }
  if(c>1){
    html+=`<div class="md">${entry.receptions.map((r,i)=>{
      const rt=r.ts?fmtMeshyTime(r.ts)+' ':'';
      return `${i+1}. ${rt}${fmtRx(r)}`;
    }).join('<br>')}</div>`;
  }
  entry.el.innerHTML=html;
}
function addMeshyMsg(m){
  const el=document.getElementById('meshy-output');
  const now=csvRows.length?nowTime():Date.now();
  const devTs=m._deviceTs||now;  // prefer device time, fall back for CSV replay
  const key=meshyDedupKey(m);
  const rx={rssi:m.rssi,snr:m.snr,hop:m.hop,hopStart:m.hopStart,ts:devTs};
  // Check for existing dedup entry within time window
  const existing=meshyDedup[key];
  if(existing&&(now-existing.ts)<MESHY_DEDUP_WINDOW){
    existing.count++;
    existing.receptions.push(rx);
    existing.ts=now;  // tracks recency for dedup window вЂ” firstTs stays fixed
    // Update position flag if node gained position since first reception
    if(!existing.has_pos && nodeHasPosition(m.node)) existing.has_pos=true;
    renderMeshyLine(existing);
    if(el.scrollHeight-el.scrollTop-el.clientHeight<60)el.scrollTop=el.scrollHeight;
    if(m.kind==='text')showMeshyMapMsg(m.node,m.text);
    updateMeshyStats();
    return;
  }
  // New entry
  const d=document.createElement('div');
  d.className='meshy-msg'+(m._tx?' tx-out':'');
  d.dataset.mk=m.kind;
  d.dataset.node=m.node;
  d.style.display=isMeshyKindVisible(m.kind)?'':'none';
  const entry={el:d,msg:m,count:1,receptions:[rx],ts:now,firstTs:devTs,has_pos:m.kind==='pos'||nodeHasPosition(m.node)};
  meshyDedup[key]=entry;
  d.addEventListener('click',(ev)=>{
    // If clicking the count badge (x3, x4...), toggle expand
    if(ev.target.dataset.expand){
      d.classList.toggle('expanded');
      ev.stopPropagation();
      return;
    }
    // Shift+click = range select from last click
    if(ev.shiftKey&&meshyLastClickedEl){
      meshySelectRange(meshyLastClickedEl,d);
      return;
    }
    // Cmd/Ctrl+click = toggle individual
    const toggle=ev.metaKey||ev.ctrlKey;
    meshySelectNode(m.node,entry,toggle);
    meshyLastClickedEl=d;
  });
  renderMeshyLine(entry);
  el.appendChild(d);meshyCount++;
  while(meshyCount>MESHY_MAX&&el.firstChild){el.removeChild(el.firstChild);meshyCount--}
  if(el.scrollHeight-el.scrollTop-el.clientHeight<60)el.scrollTop=el.scrollHeight;
  if(m.kind==='text')showMeshyMapMsg(m.node,m.text);
  updateMeshyStats();
}
function updateMeshyStats(){
  const st=document.getElementById('meshy-stats');
  const nodeCount=Object.keys(meshyNodes).length;
  let parts=[];
  const c=meshyConfig;
  if(c.region||c.preset){
    let cfg=[];
    if(c.region)cfg.push(c.region);
    if(c.preset)cfg.push(c.preset);
    if(c.role)cfg.push(c.role);
    if(c.freq)cfg.push(c.freq+' MHz');
    if(c.txPwr)cfg.push(c.txPwr+'dBm');
    if(c.hop)cfg.push('hop:'+c.hop);
    if(c.slot&&c.slot!=='auto')cfg.push('slot:'+c.slot);
    if(c.extraCh>0)cfg.push('+'+c.extraCh+'ch');
    if(c.stopped)cfg.push('STOPPED');
    parts.push(cfg.join(' В· '));
  }
  parts.push('Nodes: '+nodeCount+'  Messages: '+meshyCount);
  st.innerHTML=parts.join('<br>');
}
function esc(s){const d=document.createElement('span');d.textContent=s;return d.innerHTML}
function isMeshyKindVisible(k){
  if(k==='text')return document.getElementById('mf-text').checked;
  if(k==='join')return document.getElementById('mf-join').checked;
  if(k==='pos')return document.getElementById('mf-pos').checked;
  if(k==='telem')return document.getElementById('mf-telem').checked;
  return true;
}
function refilterMeshy(){
  const lines=document.getElementById('meshy-output').children;
  for(let i=0;i<lines.length;i++){
    const k=lines[i].dataset.mk;
    lines[i].style.display=isMeshyKindVisible(k)?'':'none';
  }
}

// --- Table sort ---
let sortCol=null, sortDir=0; // 0=default, 1=asc, -1=desc
const sortKeys=['icao','cs','alt','spd','hdg','vr','dist','brg','age','msgs'];
function tblSort(col){
  if(sortCol===col){
    if(sortDir===1)sortDir=-1;
    else if(sortDir===-1){sortCol=null;sortDir=0;}
    else sortDir=1;
  }else{sortCol=col;sortDir=1;}
  // Update header indicators
  for(const k of sortKeys){
    const el=document.getElementById('sh-'+k);
    if(el)el.textContent=(sortCol===k?(sortDir===1?'в–І':'в–ј'):'');
  }
}
function sortVal(ic,ac,n){
  const age=Math.round((n-ac.ls)/1000);
  switch(sortCol){
    case'icao':return ic;
    case'cs':return ac.cs||'zzz';
    case'alt':return ac.alt??-99999;
    case'spd':return ac.speed??-1;
    case'hdg':return ac.hdg??-1;
    case'vr':return ac.vr??0;
    case'dist':return ac.dist??999;
    case'brg':return ac.brg??999;
    case'age':return age;
    case'msgs':return ac.msgs||0;
    default:return ac.dist??999;
  }
}

// --- Tick ---
function fmtTime(d){return d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false})}
function fmtDur(ms){
  const s=Math.floor(ms/1000),m=Math.floor(s/60),h=Math.floor(m/60);
  return String(h).padStart(2,'0')+':'+String(m%60).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
}
function updSessionInfo(){
  const el=document.getElementById('session-panel');
  if(!sessStart){el.classList.remove('visible');el.innerHTML='';return}
  el.classList.add('visible');
  const now=sessEnd||new Date();
  const dur=now-sessStart;
  let html='<span class="sess-on">CONNECTED:</span><span class="sess-on">'+fmtTime(sessStart)+'</span>';
  html+='<span>DURATION:</span><span>'+fmtDur(dur)+'</span>';
  if(sessEnd)html+='<span class="sess-off">DISCONNECTED:</span><span class="sess-off">'+fmtTime(sessEnd)+'</span>';
  el.innerHTML=html;
}
function tick(){
  const n=nowTime();
  // Only expire when receiving data вЂ“ freeze state when idle
  if(conn||csvPlaying){
    for(const[ic,ac]of A){
      const age=n-ac.ls;
      if(age>EXP&&!ac.expired){
        ac.expired=true;
        if(selSet.has(ic)){
          ac.pinned=true;  // keep on map вЂ” updAc renders selected expired
        }else{
          rmAc(ac);
          selSet.delete(ic);
        }
      }
    }
  }
  // Refresh map visuals for staleness transitions (include selected expired)
  for(const[ic,ac]of A){if(!ac.expired||selSet.has(ic))updAc(ic,ac)}
  updRxRings();
  const liveCount=[...A.values()].filter(ac=>!ac.expired).length;
  document.getElementById('ac-count').textContent=liveCount;
  document.getElementById('msg-count').textContent=totM.toLocaleString();
  document.getElementById('msg-rate').textContent=(mTs.length/5).toFixed(1);
  // Lock stat widths вЂ“ only grow, never shrink
  ['ac-count','msg-count','msg-rate'].forEach(id=>{
    const el=document.getElementById(id);
    const w=el.scrollWidth;
    const cur=parseInt(el.style.minWidth)||0;
    if(w>cur)el.style.minWidth=w+'px';
  });
  if(selSet.size)updDet();
  updSessionInfo();
  updGnss();
  const tb=document.getElementById('ac-tbody');
  // Sort: expired always at bottom, then by user-selected column or default (distance)
  const so=[...A.entries()].sort((a,b)=>{
    if(a[1].expired!==b[1].expired)return a[1].expired?1:-1;
    if(sortCol&&sortDir){
      const va=sortVal(a[0],a[1],n),vb=sortVal(b[0],b[1],n);
      const cmp=typeof va==='string'?va.localeCompare(vb):va-vb;
      return cmp*sortDir;
    }
    return(a[1].dist||999)-(b[1].dist||999);
  });
  tb.innerHTML=so.map(([ic,ac])=>{
    const age=Math.round((n-ac.ls)/1000);
    const vc=ac.vr>0?'climbing':ac.vr<0?'descending':'';
    const isSel=selSet.has(ic);
    const sel=isSel?' selected':'';
    const c=acCol(ic,ac);
    if(ac.expired){
      const expOp=isSel?'opacity:0.5':'opacity:0.25';
      const expCol=isSel?'#99a':'#556';
      const dismiss=ac.pinned?`<span style="cursor:pointer;color:#ff6b6b;margin-left:4px" onclick="dismissAc('${ic}',event)">вњ•</span>`:'';
      return`<tr data-ic="${ic}" class="${sel}" style="${expOp}" onclick="sel0('${ic}',event)"><td class="col-icao" style="color:${expCol}">${ic}${dismiss}</td><td class="col-cs" style="color:${expCol}">${ac.cs||'---'}</td><td style="color:${expCol}">${ac.alt!=null?ac.alt.toLocaleString():'---'}</td><td style="color:${expCol}">${ac.speed||'---'}</td><td style="color:${expCol}">${ac.hdg!=null?ac.hdg+'В°':'---'}</td><td style="color:${expCol}">${ac.vr?(ac.vr>0?'+':'')+ac.vr:'---'}</td><td style="color:${expCol}">${ac.dist!=null?ac.dist.toFixed(1)+'nm':'---'}</td><td style="color:${expCol}">${ac.brg!=null?ac.brg+'В°':'---'}</td><td style="color:${expCol}">${age}s</td><td style="color:${expCol}">${ac.msgs||0}</td></tr>`;
    }
    const st=acStale(ac,isSel);
    const rowOp=st.gray?(isSel?'opacity:0.5':'opacity:0.35'):st.opacity<1?'opacity:0.5':'';
    const icCol=st.gray?(isSel?'#99a':'#667'):c;
    return`<tr data-ic="${ic}" class="${sel}" style="${rowOp}" onclick="sel0('${ic}',event)"><td class="col-icao" style="color:${icCol}">${ic}</td><td class="col-cs">${ac.cs||'---'}</td><td class="col-alt">${ac.alt!=null?ac.alt.toLocaleString():'---'}</td><td>${ac.speed||'---'}</td><td>${ac.hdg!=null?ac.hdg+'В°':'---'}</td><td class="col-vr ${vc}">${ac.vr?(ac.vr>0?'+':'')+ac.vr:'---'}</td><td class="col-dist">${ac.dist!=null?ac.dist.toFixed(1)+'nm':'---'}</td><td class="col-dist">${ac.brg!=null?ac.brg+'В°':'---'}</td><td class="col-dist">${age}s</td><td class="col-dist">${ac.msgs||0}</td></tr>`;
  }).join('');
  // Re-apply keyboard focus after table rebuild
  if(kbFocusIdx>=0){
    const rows=tb.querySelectorAll('tr');
    if(kbFocusIdx>=rows.length)kbFocusIdx=rows.length-1;
    if(kbFocusIdx>=0&&rows[kbFocusIdx])rows[kbFocusIdx].classList.add('kb-focus');
  }
}
function togglePanel(){const p=document.getElementById('panel');const b=document.getElementById('panel-toggle');if(p.classList.contains('collapsed')){p.classList.remove('collapsed');p.style.height=panelH+'px';b.textContent='\u25B2 Aircraft \u25B2'}else{p.classList.add('collapsed');p.style.height='';b.textContent='\u25BC Aircraft \u25BC'}syncPanelH()}

// Sync detail-wrap bottom to actual aircraft panel height
function syncPanelH(){
  const p=document.getElementById('panel');
  const h=p.classList.contains('collapsed')?44:p.offsetHeight;
  document.documentElement.style.setProperty('--panel-h',h+'px');
}

// --- Panel drag resize ---
let panelH=Math.round(window.innerHeight*0.35);
(function(){
  const panel=document.getElementById('panel');
  const drag=document.getElementById('panel-drag');
  let dragging=false,startY,startH;
  function onStart(y){dragging=true;startY=y;startH=panel.offsetHeight;if(panel.classList.contains('collapsed')){panel.classList.remove('collapsed');panel.style.height=startH+'px'}panel.style.transition='none';document.body.style.cursor='ns-resize';document.body.style.userSelect='none'}
  function onMove(y){if(!dragging)return;const h=Math.max(44,Math.min(window.innerHeight-60,startH+(startY-y)));panel.style.height=h+'px';panelH=h;syncPanelH()}
  function onEnd(){if(!dragging)return;dragging=false;panel.style.transition='';document.body.style.cursor='';document.body.style.userSelect='';if(panelH<=60){panel.classList.add('collapsed');panel.style.height='';document.getElementById('panel-toggle').textContent='\u25BC Aircraft \u25BC'}else{panel.classList.remove('collapsed');document.getElementById('panel-toggle').textContent='\u25B2 Aircraft \u25B2'}syncPanelH()}
  drag.addEventListener('mousedown',e=>{e.preventDefault();onStart(e.clientY)});
  window.addEventListener('mousemove',e=>onMove(e.clientY));
  window.addEventListener('mouseup',onEnd);
  drag.addEventListener('touchstart',e=>{e.preventDefault();onStart(e.touches[0].clientY)},{passive:false});
  window.addEventListener('touchmove',e=>{if(dragging)onMove(e.touches[0].clientY)});
  window.addEventListener('touchend',onEnd);
})();

// --- Aircraft table keyboard navigation ---
// Arrow Up/Down: move focus row. Enter or Space: select focused row.
// Shift+Arrow: extend selection to focused row. Escape: deselect all.
let kbFocusIdx=-1; // -1 = no keyboard focus
function kbApplyFocus(){
  const rows=document.querySelectorAll('#ac-tbody tr');
  rows.forEach((r,i)=>r.classList.toggle('kb-focus',i===kbFocusIdx));
  if(kbFocusIdx>=0&&kbFocusIdx<rows.length){
    const row=rows[kbFocusIdx];
    const scroll=document.getElementById('panel-scroll');
    const rr=row.getBoundingClientRect(),sr=scroll.getBoundingClientRect();
    if(rr.bottom>sr.bottom)row.scrollIntoView({block:'nearest'});
    if(rr.top<sr.top)row.scrollIntoView({block:'nearest'});
  }
}
document.getElementById('panel-scroll').addEventListener('keydown',function(e){
  if(e.key!=='ArrowUp'&&e.key!=='ArrowDown'&&e.key!=='Enter'&&e.key!==' '&&e.key!=='Escape')return;
  const rows=document.querySelectorAll('#ac-tbody tr');
  if(!rows.length)return;
  e.preventDefault();
  if(e.key==='Escape'){desel();kbFocusIdx=-1;kbApplyFocus();return}
  if(e.key==='ArrowUp'){
    kbFocusIdx=kbFocusIdx<=0?rows.length-1:kbFocusIdx-1;
    if(e.shiftKey){const ic=rows[kbFocusIdx]?.dataset.ic;if(ic)sel0(ic,{shiftKey:true})}
    kbApplyFocus();return;
  }
  if(e.key==='ArrowDown'){
    kbFocusIdx=kbFocusIdx>=rows.length-1?0:kbFocusIdx+1;
    if(e.shiftKey){const ic=rows[kbFocusIdx]?.dataset.ic;if(ic)sel0(ic,{shiftKey:true})}
    kbApplyFocus();return;
  }
  if(e.key==='Enter'||e.key===' '){
    if(kbFocusIdx>=0&&kbFocusIdx<rows.length){
      const ic=rows[kbFocusIdx]?.dataset.ic;
      if(ic)sel0(ic,e.shiftKey?{shiftKey:true}:{});
    }
    return;
  }
});

// --- Meshy panel: drag to move (header), CSS resize:both for corner ---
(function(){
  const panel=document.getElementById('meshy-panel');
  const header=document.getElementById('meshy-header');
  let dragActive=false,dragX,dragY,panelX,panelY;
  function dragStart(x,y,e){
    if(e.target.tagName==='BUTTON')return;
    dragActive=true;dragX=x;dragY=y;
    const r=panel.getBoundingClientRect();panelX=r.left;panelY=r.top;
    panel.style.transition='none';header.classList.add('dragging');
    document.body.style.userSelect='none';
  }
  function dragMove(x,y){if(!dragActive)return;
    const nx=Math.max(0,Math.min(window.innerWidth-60,panelX+(x-dragX)));
    const ny=Math.max(0,Math.min(window.innerHeight-60,panelY+(y-dragY)));
    panel.style.left=nx+'px';panel.style.top=ny+'px';panel.style.right='auto';panel.dataset.dragged='1';
  }
  function dragEnd(){if(!dragActive)return;dragActive=false;panel.style.transition='';header.classList.remove('dragging');document.body.style.userSelect=''}
  header.addEventListener('mousedown',e=>{e.preventDefault();dragStart(e.clientX,e.clientY,e)});
  window.addEventListener('mousemove',e=>{if(dragActive)dragMove(e.clientX,e.clientY)});
  window.addEventListener('mouseup',dragEnd);
  header.addEventListener('touchstart',e=>{dragStart(e.touches[0].clientX,e.touches[0].clientY,e)},{passive:true});
  window.addEventListener('touchmove',e=>{if(dragActive){e.preventDefault();dragMove(e.touches[0].clientX,e.touches[0].clientY)}},{passive:false});
  window.addEventListener('touchend',dragEnd);
})();

