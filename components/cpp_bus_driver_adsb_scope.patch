         bool begin(i2s_mclk_multiple_t mclk_multiple, uint32_t sample_rate_hz, i2s_data_bit_width_t data_bit_width) override;
 
+        // Reconfigure I2S clock for a new rate without tearing down channels.
+        // Caller must also update the codec (e.g. ES8311::set_clock_coeff).
+        bool set_clock_rate(uint32_t rate_hz) {
+            if (rate_hz == _sample_rate_hz) return true;  // no change
+
+            if (_chan_tx_handle) i2s_channel_disable(_chan_tx_handle);
+            if (_chan_rx_handle) i2s_channel_disable(_chan_rx_handle);
+
+            i2s_std_clk_config_t clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(rate_hz);
+            clk_cfg.mclk_multiple = (i2s_mclk_multiple_t)_mclk_multiple;
+
+            esp_err_t ret = ESP_OK;
+            if (_chan_tx_handle)
+                ret = i2s_channel_reconfig_std_clock(_chan_tx_handle, &clk_cfg);
+            if (ret == ESP_OK && _chan_rx_handle)
+                ret = i2s_channel_reconfig_std_clock(_chan_rx_handle, &clk_cfg);
+
+            if (_chan_tx_handle) i2s_channel_enable(_chan_tx_handle);
+            if (_chan_rx_handle) i2s_channel_enable(_chan_rx_handle);
+
+            if (ret == ESP_OK) _sample_rate_hz = rate_hz;
+            return ret == ESP_OK;
+        }
+
+        uint32_t get_clock_rate() const { return _sample_rate_hz; }
+
         size_t read(void *data, size_t byte) override;
         size_t write(const void *data, size_t byte) override;
 
